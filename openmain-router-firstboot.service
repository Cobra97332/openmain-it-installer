[Unit]
Description=OpenMain-IT NetBird Router First Boot
After=network-online.target
Conflicts=getty@tty1.service
Wants=network-online.target
ConditionPathExists=!/var/lib/openmain-router-firstboot.done

[Service]
Type=oneshot
ExecStart=/bin/bash /opt/openmain-router/firstboot-router.sh
StandardInput=tty
StandardOutput=tty
StandardError=tty
TTYPath=/dev/tty1
TTYReset=yes
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
