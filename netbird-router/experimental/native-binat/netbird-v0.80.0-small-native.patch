+//go:build !linux
+
+package binat
+
+import (
+	"errors"
+	"os"
+)
+
+type Scope struct{ Virtual, Real, Overlay, LAN string }
+type Gate struct{}
+
+var ErrUnconfirmed = errors.New("BINAT unavailable")
+
+func LoadLabFromEnv() (*Gate, error) {
+	if os.Getenv("NB_EXPERIMENTAL_BINAT_CONFIG") == "" {
+		return nil, nil
+	}
+	return nil, ErrUnconfirmed
+}
+func (*Gate) Close() error      { return ErrUnconfirmed }
+func (*Gate) Open(uint64) error { return ErrUnconfirmed }
+func (*Gate) Release()          {}
+func (*Gate) Scopes() []Scope   { return nil }
+
+func (*Gate) Prepare() (uint64, error) { return 0, ErrUnconfirmed }
+
+func (*Gate) Observe(uint64, string) error { return ErrUnconfirmed }
+
+func RequireFreshUserspaceOverlay([]Scope) error { return ErrUnconfirmed }
+func RequireEphemeralTUN(string, bool) error     { return ErrUnconfirmed }
+
+func (*Gate) BindFailStop(func()) {}
diff --git a/client/firewall/binat/stale_linux.go b/client/firewall/binat/stale_linux.go
new file mode 100644
--- /dev/null
+++ b/client/firewall/binat/stale_linux.go
@@ -0,0 +1,145 @@
+//go:build linux
+
+package binat
+
+import (
+	"bytes"
+	"errors"
+	"os"
+	"os/exec"
+	"strings"
+	"time"
+
+	nft "github.com/google/nftables"
+	"github.com/google/nftables/expr"
+	nl "github.com/mdlayher/netlink"
+)
+
+// RefuseStalePassthroughs is read-only. In particular it does not infer rule
+// ownership from an interface name or delete administrator/old-client rules.
+// Call before creating a fresh overlay; the owned readiness gate stays CLOSED.
+func RefuseStalePassthroughs(scopes []Scope) error {
+	if err := ValidateScopes(scopes); err != nil {
+		return err
+	}
+	// Avoid adopting a saved firewalld trusted-zone assignment which can outlive
+	// the TUN and be republished after this inspection. Supporting firewalld needs
+	// separate zone-state acceptance; never trust/untrust it as a shortcut.
+	for _, binary := range []string{"firewall-cmd", "firewalld"} {
+		if _, err := exec.LookPath(binary); err == nil || !errors.Is(err, exec.ErrNotFound) {
+			return errors.New("BINAT firewalld state unsupported; no trusted-zone adoption")
+		}
+	}
+	if custom := os.Getenv("NB_NFTABLES_TABLE"); custom != "" && custom != "netbird" {
+		return errors.New("BINAT requires default native table ownership")
+	}
+	// Legacy xtables rules are not visible through nftables netlink. Never
+	// claim their filter state was inspected or adopt a legacy passthrough.
+	legacy, legacyErr := os.ReadFile("/proc/net/ip_tables_names")
+	if legacyErr != nil && !errors.Is(legacyErr, os.ErrNotExist) {
+		return ErrUnconfirmed
+	}
+	for _, table := range strings.Fields(string(legacy)) {
+		if table == "filter" {
+			return errors.New("BINAT legacy iptables filter state unsupported")
+		}
+	}
+	conn, err := nft.New(nft.WithSockOptions(func(c *nl.Conn) error { return c.SetReadDeadline(time.Now().Add(10 * time.Second)) }))
+	if err != nil {
+		return ErrUnconfirmed
+	}
+	chains, err := conn.ListChains()
+	if err != nil {
+		return ErrUnconfirmed
+	}
+	for _, chain := range chains {
+		if chain == nil || chain.Table == nil {
+			return ErrUnconfirmed
+		}
+		table := chain.Table
+		if table.Family != nft.TableFamilyIPv4 && table.Family != nft.TableFamilyINet {
+			continue
+		}
+		if table.Name == "firewalld" {
+			return errors.New("BINAT foreign firewalld state refused")
+		}
+		// Only the native IPv4 work table is rebuilt by this Engine. Bootstrap
+		// independently verifies the private gate's layout before this function.
+		if table.Family == nft.TableFamilyIPv4 && (table.Name == "netbird" || table.Name == Table) {
+			continue
+		}
+		rules, err := conn.GetRules(table, chain)
+		if err != nil {
+			return ErrUnconfirmed
+		}
+		for _, rule := range rules {
+			if rule == nil {
+				return ErrUnconfirmed
+			}
+			if stalePassthrough(rule.Exprs, scopes) {
+				return errors.New("BINAT stale foreign interface passthrough; verified manual cleanup required")
+			}
+		}
+	}
+	return nil
+}
+
+// This is a refusal detector for native passthroughs, not a policy evaluator.
+// Unknown interface sets/maps are refused conservatively. Even a narrow foreign
+// ACCEPT for the target interface requires manual verification before adoption.
+func stalePassthrough(items []expr.Any, scopes []Scope) bool {
+	permitting := false
+	for _, item := range items {
+		switch v := item.(type) {
+		case *expr.Verdict:
+			// RETURN can also skip a later DROP in an accepting base chain.
+			permitting = permitting || v.Kind == expr.VerdictAccept || v.Kind == expr.VerdictJump || v.Kind == expr.VerdictGoto || v.Kind == expr.VerdictReturn
+		case *expr.Lookup:
+			// A verdict map can grant without an explicit Verdict. Data maps
+			// (including prefix DNAT) use a non-verdict destination register.
+			permitting = permitting || (v.IsDestRegSet && v.DestRegister == 0)
+		}
+	}
+	for i, item := range items {
+		meta, ok := item.(*expr.Meta)
+		if !ok || meta.SourceRegister || (meta.Key != expr.MetaKeyIIFNAME && meta.Key != expr.MetaKeyOIFNAME) {
+			continue
+		}
+		if i+1 == len(items) {
+			return true
+		}
+		// Do not try to evaluate a foreign ACL or track reused nft registers.
+		// Only a direct exact equality is an understood interface constraint.
+		// Named interface sets/maps and transforms remain unsupported even
+		// when they do not expose an inline verdict.
+		cmp, direct := items[i+1].(*expr.Cmp)
+		if !direct {
+			return true
+		}
+		if !permitting {
+			continue
+		}
+		if cmp.Register != meta.Register || cmp.Op != expr.CmpOpEq {
+			return true
+		}
+		end := bytes.IndexByte(cmp.Data, 0)
+		if end <= 0 || len(cmp.Data) > 16 {
+			return true
+		}
+		name := string(cmp.Data[:end])
+		if !names.MatchString(name) {
+			return true
+		}
+		for _, tail := range cmp.Data[end:] {
+			if tail != 0 {
+				return true
+			}
+		}
+		for _, scope := range scopes {
+			if name == scope.Overlay {
+				return true
+			}
+		}
+	}
+	return false
+}
