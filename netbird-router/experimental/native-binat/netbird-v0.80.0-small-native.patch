+func TestBINATSmallUnconfirmedKernelCloseStopsBoundOwner(t *testing.T) {
+	calls := 0
+	g, _ := New([]Scope{{"10.80.1.0/24", "192.168.80.0/24", "nb0", "lan0"}}, func(string) ([]byte, error) { return nil, errors.New("synthetic read failure") })
+	g.BindFailStop(func() { calls++ })
+	if g.Close() == nil || calls != 1 || !g.poisoned {
