+//go:build linux
+
+package binat
+
+import (
+	"os"
+	"path/filepath"
+	"testing"
+
+	"github.com/google/nftables/expr"
+)
+
+func TestBINATSmallStalePassthroughs(t *testing.T) {
+	scopes := []Scope{{"10.80.1.0/24", "192.168.80.0/24", "nb0", "lan0"}}
+	for _, key := range []expr.MetaKey{expr.MetaKeyIIFNAME, expr.MetaKeyOIFNAME} {
+		for _, verdict := range []expr.VerdictKind{expr.VerdictAccept, expr.VerdictJump, expr.VerdictGoto, expr.VerdictReturn} {
+			for _, name := range []string{"nb0\x00", "nb", "nb*", ""} {
+				items := []expr.Any{&expr.Meta{Key: key, Register: 1}, &expr.Cmp{Register: 1, Data: []byte(name)}, &expr.Verdict{Kind: verdict}}
+				if !stalePassthrough(items, scopes) {
+					t.Fatal("stale interface permit not refused")
+				}
+			}
+		}
+	}
+	for _, name := range []string{"lo\x00", "nb0\x00", "eth9\x00"} {
+		inverted := []expr.Any{&expr.Meta{Key: expr.MetaKeyIIFNAME, Register: 1}, &expr.Cmp{Register: 1, Op: expr.CmpOpNeq, Data: []byte(name)}, &expr.Verdict{Kind: expr.VerdictAccept}}
+		if !stalePassthrough(inverted, scopes) {
+			t.Fatal("inverted interface permit not refused")
+		}
+	}
+	unrelated := []expr.Any{&expr.Meta{Key: expr.MetaKeyIIFNAME, Register: 1}, &expr.Cmp{Register: 1, Data: []byte("eth9\x00")}, &expr.Verdict{Kind: expr.VerdictAccept}}
+	if stalePassthrough(unrelated, scopes) {
+		t.Fatal("unrelated interface refused")
+	}
+	drop := []expr.Any{&expr.Meta{Key: expr.MetaKeyIIFNAME, Register: 1}, &expr.Cmp{Register: 1, Data: []byte("nb0\x00")}, &expr.Verdict{Kind: expr.VerdictDrop}}
+	if stalePassthrough(drop, scopes) {
+		t.Fatal("administrator drop refused")
+	}
+	verdictMap := []expr.Any{&expr.Meta{Key: expr.MetaKeyIIFNAME, Register: 1}, &expr.Cmp{Op: expr.CmpOpNeq, Register: 1, Data: []byte("lo\x00")}, &expr.Payload{DestRegister: 1}, &expr.Lookup{SourceRegister: 1, IsDestRegSet: true, DestRegister: 0, SetName: "decisions"}}
+	if !stalePassthrough(verdictMap, scopes) {
+		t.Fatal("verdict map after overwritten interface register accepted")
+	}
+	translation := []expr.Any{&expr.Meta{Key: expr.MetaKeyIIFNAME, Register: 1}, &expr.Cmp{Register: 1, Data: []byte("nb0\x00")}, &expr.Payload{DestRegister: 1}, &expr.Lookup{SourceRegister: 1, DestRegister: 1, IsDestRegSet: true, SetName: "prefix-translation"}}
+	if stalePassthrough(translation, scopes) {
+		t.Fatal("IP lookup after register overwrite mistaken for interface map")
+	}
+	unrelatedSet := append(append([]expr.Any{}, unrelated[:2]...), &expr.Payload{DestRegister: 1}, &expr.Lookup{SourceRegister: 1, SetName: "source-addresses"}, &expr.Verdict{Kind: expr.VerdictAccept})
+	if stalePassthrough(unrelatedSet, scopes) {
+		t.Fatal("unrelated IP set mistaken for interface map")
+	}
+	lookup := []expr.Any{&expr.Meta{Key: expr.MetaKeyIIFNAME, Register: 1}, &expr.Lookup{SourceRegister: 1, SetName: "unknown-interface-map"}}
+	if !stalePassthrough(lookup, scopes) {
+		t.Fatal("unknown interface set/map accepted")
+	}
+}
+
+func TestBINATSmallFirewalldRefusedBeforeKernelOrCommands(t *testing.T) {
+	dir := t.TempDir()
+	// If executed, this synthetic command would leave a marker. It must never run.
+	marker := filepath.Join(dir, "executed")
+	command := []byte("#!/bin/sh\ntouch " + marker + "\n")
+	if err := os.WriteFile(filepath.Join(dir, "firewall-cmd"), command, 0700); err != nil {
+		t.Fatal(err)
+	}
+	t.Setenv("PATH", dir)
+	if RefuseStalePassthroughs([]Scope{{"10.80.1.0/24", "192.168.80.0/24", "nb0", "lan0"}}) == nil {
+		t.Fatal("firewalld state accepted")
+	}
+	if _, err := os.Stat(marker); !os.IsNotExist(err) {
+		t.Fatal("firewall command was executed")
+	}
+}
