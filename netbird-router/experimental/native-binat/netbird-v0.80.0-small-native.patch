+	if validateTUNLink(&netlink.Tuntap{Mode: netlink.TUNTAP_MODE_TUN, NonPersist: true}) != nil {
+		t.Fatal("ephemeral TUN refused")
+	}
+}
+
+func TestBINATSmallNativeTableCollisionRefusedBeforeIO(t *testing.T) {
+	t.Setenv("NB_EXPERIMENTAL_BINAT_CONFIG", Root+"/config.json")
+	t.Setenv("OPENMAIN_ISOLATED_TEST", "1")
+	t.Setenv("NB_NFTABLES_TABLE", Table)
