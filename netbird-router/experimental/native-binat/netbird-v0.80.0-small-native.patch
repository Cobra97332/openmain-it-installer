+func TestBINATSmallCachedKernelLayoutStillRejectsMutation(t *testing.T) {
+	base := `{"nftables":[{"table":{"family":"ip","name":"netbird_binat_native_gate_v1"}},{"chain":{"family":"ip","table":"netbird_binat_native_gate_v1","name":"ready"}},{"chain":{"family":"ip","table":"netbird_binat_native_gate_v1","name":"guard"}}]}`
+	expected, err := canonical([]byte(base), Table)
+	if err != nil {
+		t.Fatal(err)
+	}
+	changed := strings.Replace(base, `"name":"ready"`, `"name":"unknown"`, 1)
+	live := base
+	calls := 0
+	g, _ := New([]Scope{{"10.80.1.0/24", "192.168.80.0/24", "nb0", "lan0"}}, func(script string) ([]byte, error) {
+		calls++
+		if script != "list table ip "+Table+"\n" {
+			t.Fatal("cached verification mutated kernel")
+		}
+		return []byte(live), nil
+	})
+	g.references = [2]string{expected, expected}
+	if g.known() != nil || calls != 1 {
+		t.Fatal("cached layout rejected")
+	}
+	live = changed
+	if g.known() == nil {
+		t.Fatal("cache hid a foreign/unknown layout")
+	}
+}
+
+func TestBINATSmallAbsentOptInStillInspectsOrphansBeforeStartup(t *testing.T) {
+	t.Setenv("NB_EXPERIMENTAL_BINAT_CONFIG", "")
+	calls := 0
+	for _, name := range []string{Table, "netbird_binat_experiment_v3"} {
+		gate, err := loadLabFromEnv(func() error {
+			calls++
+			return orphanedBoundary([]*nft.Table{{Name: name, Family: nft.TableFamilyIPv4}}, nil)
+		})
+		if gate != nil || err == nil {
+			t.Fatal("orphaned gate admitted without config")
+		}
+	}
+	if calls != 2 {
+		t.Fatal("missing opt-in skipped inspection")
+	}
+	gate, err := loadLabFromEnv(func() error {
+		return orphanedBoundary([]*nft.Table{{Name: "foreign", Family: nft.TableFamilyIPv4}}, nil)
+	})
+	if gate != nil || err != nil {
+		t.Fatal("ordinary clean startup altered")
+	}
+	if _, err := loadLabFromEnv(func() error { return ErrUnconfirmed }); err == nil {
+		t.Fatal("uninspectable state admitted")
+	}
+}
+func TestBINATSmallNativeOrphanDetectedWithoutGateTable(t *testing.T) {
+	chains := []*nft.Chain{{Name: "netbird-binat-native", Table: &nft.Table{Name: "netbird", Family: nft.TableFamilyIPv4}}}
+	if orphanedBoundary(nil, chains) == nil {
+		t.Fatal("native orphan admitted")
+	}
+	if orphanedBoundary(nil, []*nft.Chain{{Name: "ordinary", Table: &nft.Table{Name: "foreign", Family: nft.TableFamilyIPv4}}}) != nil {
+		t.Fatal("foreign rules rejected")
+	}
+}
