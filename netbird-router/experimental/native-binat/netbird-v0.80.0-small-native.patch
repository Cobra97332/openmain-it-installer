+// Scope authorization is evaluated after NAT in BOTH directions. Keep native
+// RuleIDs, source sets, port sets, priorities and verdicts; change only loads.
+func originalRouteTuple(items []expr.Any) []expr.Any {
+	for i, item := range items {
+		switch v := item.(type) {
+		case *expr.Payload:
+			key := expr.CtKey(0xffffffff)
+			if v.Base == expr.PayloadBaseNetworkHeader && v.Len == 4 {
+				if v.Offset == 12 {
+					key = expr.CtKeySRC
+				}
+				if v.Offset == 16 {
+					key = expr.CtKeyDST
+				}
+			}
+			if v.Base == expr.PayloadBaseTransportHeader && v.Len == 2 {
+				if v.Offset == 0 {
+					key = expr.CtKeyPROTOSRC
+				}
+				if v.Offset == 2 {
+					key = expr.CtKeyPROTODST
+				}
+			}
+			if key != expr.CtKey(0xffffffff) {
+				items[i] = &expr.Ct{Key: key, Register: v.DestRegister, Direction: 0}
+			}
+		case *expr.Meta:
+			if v.Key == expr.MetaKeyL4PROTO {
+				items[i] = &expr.Ct{Key: expr.CtKeyPROTOCOL, Register: v.Register, Direction: 0}
+			}
+		}
+	}
+	return items
+}
