+// BINATPolicyPublisher is an EXPERIMENTAL synchronous policy barrier.
+// Begin MUST close the protected packet path before validating/preparing the
+// COMPLETE map. Commit may publish only that prepared map atomically. Close
+// leaves it denied. The backend must retain its boundary across native resets.
+// This seam alone is NOT a usable BINAT implementation.
+type BINATPolicyPublisher interface {
+	Begin(*mgmProto.NetworkMap, bool) error
+	Commit() error
+	Close() error
+}
+
+// NewDefaultManagerWithBINATPublisher is lab-only; the normal factory is unchanged.
+// No installer selects this constructor. Bootstrap/reset/engine wiring and a
+// native nftables implementation remain mandatory before production use.
+func NewDefaultManagerWithBINATPublisher(fm firewall.Manager, publisher BINATPolicyPublisher) (*DefaultManager, error) {
+	if fm == nil || publisher == nil {
+		return nil, errors.New("BINAT requires a native backend and publisher")
+	}
+	if err := publisher.Close(); err != nil {
+		return nil, errors.New("BINAT initial closure unconfirmed")
+	}
+	d := NewDefaultManager(fm)
+	d.binatPublisher = publisher
+	return d, nil
+}
+
