+func binatReturnTraffic(table *nftables.Table, chain *nftables.Chain) []expr.Any {
+	items := getEstablishedExprs(1)
+	if !binat.Active() || table.Family != nftables.TableFamilyIPv4 || chain.Name != chainNameRoutingFw {
+		return items
+	}
+	var conditions []expr.Any
+	for _, scope := range binat.Scopes() {
+		prefix, _ := netip.ParsePrefix(scope.Virtual)
+		match := prefixMatchExprs(afIPv4, prefix, false)
+		match = originalRouteTuple(match)
+		cmp := match[len(match)-1].(*expr.Cmp)
+		cmp.Op = expr.CmpOpNeq
+		conditions = append(conditions, match...)
+	}
+	return append(conditions, items...)
+}
diff --git a/client/internal/acl/binat_map_linux.go b/client/internal/acl/binat_map_linux.go
new file mode 100644
--- /dev/null
+++ b/client/internal/acl/binat_map_linux.go
@@ -0,0 +1,136 @@
+//go:build linux
+
+package acl
+
+import (
+	"crypto/sha256"
+	"encoding/hex"
+	"errors"
+	"github.com/netbirdio/netbird/client/firewall/binat"
+	mgm "github.com/netbirdio/netbird/shared/management/proto"
+	"google.golang.org/protobuf/proto"
+	"net/netip"
+)
+
+// ValidateBINATMap checks the complete authoritative NetworkMap, not live nft rules
+// or a per-rule callback. Unsupported/ambiguous maps never publish a subset.
+func ValidateBINATMap(m *mgm.NetworkMap, scopes []binat.Scope) error {
+	if m == nil || len(m.RoutesFirewallRules) == 0 && !m.RoutesFirewallRulesIsEmpty {
+		return errors.New("BINAT complete route policy missing")
+	}
+	if len(m.FirewallRules) == 0 && !m.FirewallRulesIsEmpty {
+		return errors.New("BINAT complete peer policy missing")
+	}
+	if len(m.ForwardingRules) != 0 {
+		return errors.New("BINAT forwarding services unsupported")
+	}
+
+	for _, r := range m.RoutesFirewallRules {
+		if r != nil && len(r.ProtoReflect().GetUnknown()) != 0 {
+			return errors.New("BINAT unknown route policy fields")
+		}
+		if r == nil || r.IsDynamic || len(r.Domains) > 0 || r.CustomProtocol != 0 {
+			return errors.New("BINAT dynamic/custom route unsupported")
+		}
+		dest, err := netip.ParsePrefix(r.Destination)
+		if err != nil || dest != dest.Masked() {
+			return errors.New("BINAT invalid route destination")
+		}
+		intersects, contained := false, false
+		for _, s := range scopes {
+			v, _ := netip.ParsePrefix(s.Virtual)
+			if v.Overlaps(dest) {
+				intersects = true
+				if v.Contains(dest.Addr()) && dest.Bits() >= v.Bits() {
+					contained = true
+				}
+			}
+		}
+		if !intersects {
+			continue
+		}
+		if !contained {
+			return errors.New("BINAT ambiguous route selector")
+		}
+		protocol := ""
+		switch r.Protocol {
+		case mgm.RuleProtocol_ALL:
+			protocol = "all"
+		case mgm.RuleProtocol_TCP:
+			protocol = "tcp"
+		case mgm.RuleProtocol_UDP:
+			protocol = "udp"
+		case mgm.RuleProtocol_ICMP:
+			protocol = "icmp"
+		default:
+			return errors.New("BINAT unsupported route protocol")
+		}
+
+		switch r.Action {
+		case mgm.RuleAction_ACCEPT:
+
+		case mgm.RuleAction_DROP:
+
+		default:
+			return errors.New("BINAT unsupported route action")
+		}
+		var ports [][2]uint16
+		if r.PortInfo != nil {
+			if len(r.PortInfo.ProtoReflect().GetUnknown()) != 0 {
+				return errors.New("BINAT unknown port selector")
+			}
+			switch sel := r.PortInfo.PortSelection.(type) {
+			case nil:
+				// NetBird v0.80.0 GetProtoPortInfo always returns a message;
+				// an exact empty message means no port restriction. Native
+				// convertPortInfo treats this identically to a nil pointer.
+			case *mgm.PortInfo_Port:
+				if sel == nil || sel.Port == 0 || sel.Port > 65535 {
+					return errors.New("BINAT invalid port")
+				}
+				ports = append(ports, [2]uint16{uint16(sel.Port), uint16(sel.Port)})
+			case *mgm.PortInfo_Range_:
+				if sel == nil || sel.Range == nil || sel.Range.Start == 0 || sel.Range.Start > sel.Range.End || sel.Range.End > 65535 {
+					return errors.New("BINAT invalid port range")
+				}
+				if len(sel.Range.ProtoReflect().GetUnknown()) != 0 {
+					return errors.New("BINAT unknown port selector")
+				}
+				ports = append(ports, [2]uint16{uint16(sel.Range.Start), uint16(sel.Range.End)})
+			default:
+				return errors.New("BINAT incomplete port selector")
+			}
+		}
+		if len(ports) > 0 && protocol != "tcp" && protocol != "udp" {
+			return errors.New("BINAT ports on unsupported protocol")
+		}
+		// A complete v0.80.0 map can retain a rule with zero sources after
+		// membership withdrawal. Native applyRouteACL skips it and deletes
+		// the previous backend rule; it is NEVER a wildcard permission.
+		for _, source := range r.SourceRanges {
+			prefix, err := netip.ParsePrefix(source)
+			if err != nil || !prefix.Addr().Is4() || prefix != prefix.Masked() {
+				return errors.New("BINAT invalid source")
+			}
+		}
+	}
+	return nil
+}
+
+// Bind unsupported and partial maps too, without retaining any raw policy data.
+// A conservative deterministic policy encoding includes all proto rule fields;
+// reordered same-serial messages can refuse availability rather than grant.
+func BINATPolicyDigest(m *mgm.NetworkMap) (string, error) {
+	if m == nil {
+		return "", errors.New("BINAT missing observed policy")
+	}
+	policy := &mgm.NetworkMap{FirewallRules: m.FirewallRules, FirewallRulesIsEmpty: m.FirewallRulesIsEmpty,
+		RoutesFirewallRules: m.RoutesFirewallRules, RoutesFirewallRulesIsEmpty: m.RoutesFirewallRulesIsEmpty,
+		ForwardingRules: m.ForwardingRules}
+	raw, err := (proto.MarshalOptions{Deterministic: true}).Marshal(policy)
+	if err != nil {
+		return "", errors.New("BINAT observation encoding failed")
+	}
+	sum := sha256.Sum256(raw)
+	return hex.EncodeToString(sum[:]), nil
+}
