+	if g.Open(0) == nil {
+		t.Fatal("unknown kernel opened")
+	}
+	for _, s := range calls {
+		if strings.Contains(s, "native-policy-ready") {
+			t.Fatal("grant attempted")
+		}
+	}
+}
