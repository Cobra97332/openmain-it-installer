# OpenMain Raspberry Pi -> PBS Gateway auf Proxmox VE
# Diese Datei wird vom PVE-Installer normalerweise automatisch erzeugt.
# chmod 0600

PVE_STORAGE_ID="PBS_Terramaster"
STAGING_BASE="/var/lib/openmain-rpi-pbs/staging"

# Wird aus /etc/pve/storage.cfg erzeugt.
PBS_REPOSITORY="root@pam@192.0.2.10:Backup"

# Vorhandene PVE-Credential-Datei; Secret wird nicht nach /etc/openmain kopiert.
PBS_PASSWORD_FILE="/etc/pve/priv/storage/PBS_Terramaster.pw"
PBS_FINGERPRINT=""
PBS_NAMESPACE=""

# Optional: clientseitige PBS-Verschlüsselung.
PBS_KEYFILE=""

# legacy, data oder metadata
PBS_CHANGE_DETECTION="data"

RESTORE_BASE="/var/lib/openmain-rpi-pbs/restore"
