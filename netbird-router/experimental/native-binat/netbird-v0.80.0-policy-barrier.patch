@@ -0,0 +1,82 @@
+package acl
+
+import (
+	"errors"
+	"reflect"
+	"testing"
+
+	fw "github.com/netbirdio/netbird/client/firewall/manager"
+	proto "github.com/netbirdio/netbird/shared/management/proto"
+)
+
+type binatFirewallFixture struct {
+	fw.Manager
+	events *[]string
+	fail   bool
+}
+
+func (f *binatFirewallFixture) Flush() error {
+	*f.events = append(*f.events, "native-flush")
+	if f.fail {
+		return errors.New("synthetic flush failure")
+	}
+	return nil
+}
+
+type binatPublisherFixture struct {
+	events                *[]string
+	beginFail, commitFail bool
+}
+
+func (p *binatPublisherFixture) Begin(*proto.NetworkMap, bool) error {
+	*p.events = append(*p.events, "begin-closed")
+	if p.beginFail {
+		return errors.New("synthetic preparation failure")
+	}
+	return nil
+}
+func (p *binatPublisherFixture) Commit() error {
+	*p.events = append(*p.events, "commit")
+	if p.commitFail {
+		return errors.New("synthetic commit failure")
+	}
+	return nil
+}
+func (p *binatPublisherFixture) Close() error { *p.events = append(*p.events, "close"); return nil }
+
+func TestBINATBarrierClosesBeforeNativeAndDoesNotSkipIdenticalMaps(t *testing.T) {
+	events := []string{}
+	native := &binatFirewallFixture{events: &events}
+	publisher := &binatPublisherFixture{events: &events}
+	manager, err := NewDefaultManagerWithBINATPublisher(native, publisher)
+	if err != nil {
+		t.Fatal(err)
+	}
+	m := &proto.NetworkMap{FirewallRulesIsEmpty: true, RoutesFirewallRulesIsEmpty: true}
+	manager.ApplyFiltering(m, false)
+	manager.ApplyFiltering(m, false)
+	want := []string{"close", "begin-closed", "native-flush", "commit", "begin-closed", "native-flush", "commit"}
+	if !reflect.DeepEqual(events, want) {
+		t.Fatalf("publication order: %v", events)
+	}
+}
+func TestBINATBarrierFailureDoesNotPublish(t *testing.T) {
+	for _, mode := range []string{"prepare", "native", "commit"} {
+		t.Run(mode, func(t *testing.T) {
+			events := []string{}
+			native := &binatFirewallFixture{events: &events, fail: mode == "native"}
+			publisher := &binatPublisherFixture{events: &events, beginFail: mode == "prepare", commitFail: mode == "commit"}
+			manager, err := NewDefaultManagerWithBINATPublisher(native, publisher)
+			if err != nil {
+				t.Fatal(err)
+			}
+			manager.ApplyFiltering(&proto.NetworkMap{FirewallRulesIsEmpty: true, RoutesFirewallRulesIsEmpty: true}, false)
+			if events[len(events)-1] != "close" || manager.hasAppliedConfig {
+				t.Fatal("failure retained successful publication")
+			}
+			if mode == "prepare" && !reflect.DeepEqual(events, []string{"close", "begin-closed", "close"}) {
+				t.Fatal(events)
+			}
+		})
+	}
+}
