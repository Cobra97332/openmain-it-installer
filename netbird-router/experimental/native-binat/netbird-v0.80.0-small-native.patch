+package client
+
+import (
+	"errors"
+	"sync"
+	"testing"
+)
+
+func TestBINATSyncLossClosesBeforeRetryWithoutTransportLock(t *testing.T) {
+	c := &GrpcClient{}
+	want := errors.New("synthetic stream loss")
+	closed := false
+	c.SetSyncDisconnectListener(func(err error) {
+		if err != want || c.syncStreamError() != want {
+			t.Error("disconnect state not visible")
+		}
+		closed = true
+	})
+	c.setSyncStreamDisconnected(want)
+	if !closed {
+		t.Fatal("stream loss returned before local closure")
+	}
+	c.SetSyncDisconnectListener(nil)
+	closed = false
+	c.setSyncStreamDisconnected(want)
+	if closed {
+		t.Fatal("released engine listener invoked")
+	}
+}
+
+func TestBINATSyncDisconnectListenerReplacementRace(t *testing.T) {
+	c := &GrpcClient{}
+	var wg sync.WaitGroup
+	wg.Add(2)
+	go func() {
+		defer wg.Done()
+		for i := 0; i < 100; i++ {
+			c.SetSyncDisconnectListener(func(error) {})
+		}
+		c.SetSyncDisconnectListener(nil)
+	}()
+	go func() {
+		defer wg.Done()
+		for i := 0; i < 100; i++ {
+			c.setSyncStreamDisconnected(errors.New("synthetic"))
+			c.setSyncStreamConnected()
+		}
+	}()
+	wg.Wait()
+}
