+
+func TestBINATSmallNativeCompleteMapValidation(t *testing.T) {
+	scopes := []binat.Scope{{Virtual: "10.80.1.0/24", Real: "192.168.80.0/24", Overlay: "nb0", LAN: "lan0"}}
+	rule := &p.RouteFirewallRule{SourceRanges: []string{"100.64.0.10/32", "100.64.0.11/32"}, Destination: "10.80.1.0/24", Protocol: p.RuleProtocol_TCP, Action: p.RuleAction_DROP, PortInfo: &p.PortInfo{PortSelection: &p.PortInfo_Range_{Range: &p.PortInfo_Range{Start: 443, End: 445}}}}
+	m := &p.NetworkMap{Serial: 8, FirewallRulesIsEmpty: true, RoutesFirewallRules: []*p.RouteFirewallRule{rule}}
+	if err := ValidateBINATMap(m, scopes); err != nil {
+		t.Fatal(err)
+	}
+	if len(rule.SourceRanges) != 2 || rule.Action != p.RuleAction_DROP {
+		t.Fatal("validation mutated native map")
+	}
+	for _, source := range []string{"invalid", "100.64.0.1/24"} {
+		rule.SourceRanges = []string{source}
+		if ValidateBINATMap(m, scopes) == nil {
+			t.Fatal("invalid source accepted")
+		}
+	}
+	rule.SourceRanges = []string{"100.64.0.10/32"}
+	rule.IsDynamic = true
+	if ValidateBINATMap(m, scopes) == nil {
+		t.Fatal("dynamic map accepted")
+	}
+	rule.IsDynamic = false
+	m.RoutesFirewallRules = nil
+	if ValidateBINATMap(m, scopes) == nil {
+		t.Fatal("partial map accepted")
+	}
+	m.RoutesFirewallRulesIsEmpty = true
+	if err := ValidateBINATMap(m, scopes); err != nil {
+		t.Fatal(err)
+	}
+	if ValidateBINATMap(nil, scopes) == nil {
+		t.Fatal("missing map accepted")
+	}
+}
+
+func TestBINATSmallNativeControllerEmptyPortInfo(t *testing.T) {
+	scopes := []binat.Scope{{Virtual: "10.80.1.0/24", Real: "192.168.80.0/24", Overlay: "nb0", LAN: "lan0"}}
+	empty := networkmap.GetProtoPortInfo(&types.RouteFirewallRule{})
+	if empty == nil || empty.GetPortSelection() != nil {
+		t.Fatal("pinned controller port encoding changed")
+	}
+	rule := &p.RouteFirewallRule{SourceRanges: []string{"100.64.0.10/32"}, Destination: "10.80.1.0/24", Action: p.RuleAction_ACCEPT, PortInfo: empty}
+	m := &p.NetworkMap{FirewallRulesIsEmpty: true, RoutesFirewallRules: []*p.RouteFirewallRule{rule}}
+	for _, protocol := range []p.RuleProtocol{p.RuleProtocol_ALL, p.RuleProtocol_TCP, p.RuleProtocol_UDP, p.RuleProtocol_ICMP} {
+		rule.Protocol = protocol
+		if err := ValidateBINATMap(m, scopes); err != nil {
+			t.Fatalf("native unrestricted protocol rejected: %v", err)
+		}
+	}
+	rule.Protocol = p.RuleProtocol_TCP
+	for _, invalid := range []*p.PortInfo{
+		{PortSelection: (*p.PortInfo_Port)(nil)},
+		{PortSelection: (*p.PortInfo_Range_)(nil)},
+		{PortSelection: &p.PortInfo_Port{Port: 0}},
+		{PortSelection: &p.PortInfo_Port{Port: 65536}},
+		{PortSelection: &p.PortInfo_Range_{Range: nil}},
+		{PortSelection: &p.PortInfo_Range_{Range: &p.PortInfo_Range{Start: 443, End: 0}}},
+		{PortSelection: &p.PortInfo_Range_{Range: &p.PortInfo_Range{Start: 445, End: 443}}},
+	} {
+		rule.PortInfo = invalid
+		if ValidateBINATMap(m, scopes) == nil {
+			t.Fatal("malformed explicit port selector accepted")
+		}
+	}
+	rule.PortInfo = &p.PortInfo{}
+	rule.PortInfo.ProtoReflect().SetUnknown([]byte{0x18, 0x01})
+	if ValidateBINATMap(m, scopes) == nil {
+		t.Fatal("unknown port fields accepted")
+	}
+}
+
+func TestBINATSmallNativeUnknownNestedPortRange(t *testing.T) {
+	scopes := []binat.Scope{{Virtual: "10.80.1.0/24", Real: "192.168.80.0/24", Overlay: "nb0", LAN: "lan0"}}
+	span := &p.PortInfo_Range{Start: 443, End: 445}
+	span.ProtoReflect().SetUnknown([]byte{0x18, 0x01})
+	rule := &p.RouteFirewallRule{SourceRanges: []string{"100.64.0.10/32"}, Destination: "10.80.1.0/24", Protocol: p.RuleProtocol_TCP, Action: p.RuleAction_ACCEPT, PortInfo: &p.PortInfo{PortSelection: &p.PortInfo_Range_{Range: span}}}
+	m := &p.NetworkMap{FirewallRulesIsEmpty: true, RoutesFirewallRules: []*p.RouteFirewallRule{rule}}
+	if ValidateBINATMap(m, scopes) == nil {
+		t.Fatal("unknown nested port-range fields accepted")
+	}
+	span.ProtoReflect().SetUnknown(nil)
+	if err := ValidateBINATMap(m, scopes); err != nil {
+		t.Fatal(err)
+	}
+}
+
+type binatEmptySourcesRule struct{}
+
+func (binatEmptySourcesRule) ID() firewall.RuleID { return "previous-permission" }
+
+type binatEmptySourcesBackend struct {
+	firewall.Manager
+	deleted int
+	fail    bool
+}
+
+func (b *binatEmptySourcesBackend) DeleteFilterRule(firewall.Rule) error {
+	b.deleted++
+	if b.fail {
+		return errors.New("synthetic deletion failure")
+	}
+	return nil
+}
+
+func TestBINATSmallNativeZeroSourcesWithdrawsWithoutWildcard(t *testing.T) {
+	scopes := []binat.Scope{{Virtual: "10.80.1.0/24", Real: "192.168.80.0/24", Overlay: "nb0", LAN: "lan0"}}
+	rule := &p.RouteFirewallRule{SourceRanges: nil, Destination: "10.80.1.0/24", Protocol: p.RuleProtocol_ALL, Action: p.RuleAction_ACCEPT, PortInfo: networkmap.GetProtoPortInfo(&types.RouteFirewallRule{})}
+	m := &p.NetworkMap{FirewallRulesIsEmpty: true, RoutesFirewallRules: []*p.RouteFirewallRule{rule}}
+	if err := ValidateBINATMap(m, scopes); err != nil {
+		t.Fatal(err)
+	}
+	for _, fail := range []bool{false, true} {
+		backend := &binatEmptySourcesBackend{fail: fail}
+		manager := NewDefaultManagerForBINAT(backend)
+		old := binatEmptySourcesRule{}
+		manager.routeRules[old.ID()] = old
+		err := manager.applyRouteACLs(m.RoutesFirewallRules, false)
+		if backend.deleted != 1 || (err != nil) != fail {
+			t.Fatal("native withdrawal outcome not confirmed")
+		}
+		if fail && len(manager.routeRules) != 1 || !fail && len(manager.routeRules) != 0 {
+			t.Fatal("native route tracking lost or retained incorrectly")
+		}
+		// Embedded nil Manager panics if any AddFilterRule/wildcard is attempted.
+	}
+	rule.Protocol = p.RuleProtocol_UNKNOWN
+	if ValidateBINATMap(m, scopes) == nil {
+		t.Fatal("empty-source rule bypassed semantic validation")
+	}
+}
+
+func TestBINATSmallNativeUnknownRouteFields(t *testing.T) {
+	scopes := []binat.Scope{{Virtual: "10.80.1.0/24", Real: "192.168.80.0/24", Overlay: "nb0", LAN: "lan0"}}
+	rule := &p.RouteFirewallRule{SourceRanges: []string{"100.64.0.10/32"}, Destination: "10.80.1.0/24", Protocol: p.RuleProtocol_ALL, Action: p.RuleAction_ACCEPT}
+	m := &p.NetworkMap{FirewallRulesIsEmpty: true, RoutesFirewallRules: []*p.RouteFirewallRule{rule}}
+	rule.ProtoReflect().SetUnknown([]byte{0x98, 0x06, 0x01})
+	if ValidateBINATMap(m, scopes) == nil {
+		t.Fatal("unknown route rule fields accepted")
+	}
+	rule.ProtoReflect().SetUnknown(nil)
+	if err := ValidateBINATMap(m, scopes); err != nil {
+		t.Fatal(err)
+	}
+}
