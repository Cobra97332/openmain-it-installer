+)
+
+var testScopes = []Scope{{Virtual: "10.80.1.0/24", Real: "192.168.80.0/24", Overlay: "nb0", LAN: "lan0"}}
+var testRule = Rule{Source: "100.64.0.10/32", Destination: "10.80.1.0/24", Protocol: "udp", Action: "accept", Ports: [][2]uint16{{12345, 12345}}}
+
+func TestBINATNativeCompileDeniesBeforeAcceptAndOriginalPorts(t *testing.T) {
+	deny := testRule
+	deny.Action = "drop"
+	text, err := Compile(testScopes, []Rule{testRule, deny})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if strings.Index(text, " counter drop") > strings.Index(text, " counter accept") || !strings.Contains(text, "ct original proto-dst 12345-12345") {
+		t.Fatal("incorrect native selector ordering")
+	}
+	for _, bad := range []Rule{{Source: testRule.Source, Destination: testRule.Destination, Protocol: "udp", Action: "accept", Ports: [][2]uint16{{0, 0}}}, {Source: testRule.Source, Destination: testRule.Destination, Protocol: "custom", Action: "accept"}, {Source: testRule.Source, Destination: "0.0.0.0/0", Protocol: "all", Action: "accept"}} {
+		if _, err := Compile(testScopes, []Rule{bad}); err == nil {
+			t.Fatal("invalid selector accepted")
+		}
+	}
+}
+func TestBINATNativeRuleFingerprintRetainsOwnershipAndIgnoresCounters(t *testing.T) {
+	first := []byte(`{"nftables":[{"rule":{"chain":"current","handle":1,"expr":[{"counter":{"packets":2}}],"comment":"one"}}]}`)
+	second := []byte(`{"nftables":[{"rule":{"chain":"current","handle":42,"expr":[{"counter":{"packets":25}}],"comment":"one"}}]}`)
+	a, _ := fingerprint(first, "current")
+	b, _ := fingerprint(second, "current")
+	if a != b {
+		t.Fatal("volatile state changes digest")
+	}
+	changed := strings.ReplaceAll(string(second), "one", "two")
+	c, _ := fingerprint([]byte(changed), "current")
+	if a == c {
+		t.Fatal("ownership not included")
+	}
+}
+
+type fixture struct{ open, loseACK, failClose bool }
+
+func dump(chain string, open bool) []byte {
+	data := []any{map[string]any{"chain": map[string]any{"name": chain, "type": "filter", "hook": "postrouting", "prio": -200, "policy": "accept"}}}
+	if open {
+		data = append(data, map[string]any{"rule": map[string]any{"chain": chain, "expr": []any{map[string]any{"accept": nil}}, "comment": "prepared"}})
+	}
+	b, _ := json.Marshal(map[string]any{"nftables": data})
+	return b
+}
+func (f *fixture) run(text string) ([]byte, error) {
+	if strings.Contains(text, "_prepared") && strings.Contains(text, "list chain") {
+		return dump("current", true), nil
+	}
+	if strings.Contains(text, "list chain ip "+Table+" guard") {
+		return dump("guard", false), nil
+	}
+	if strings.Contains(text, "list chain ip "+Table+" current") {
+		return dump("current", f.open), nil
+	}
+	if strings.Contains(text, "flush chain") {
+		if f.open && f.failClose && !strings.Contains(text, "add rule") {
+			return nil, errors.New("synthetic close failure")
+		}
+		f.open = strings.Contains(text, "add rule")
