+func TestBINATSmallPersistentAndTAPRefused(t *testing.T) {
+	for _, link := range []netlink.Link{&netlink.Device{}, &netlink.Tuntap{Mode: netlink.TUNTAP_MODE_TUN, NonPersist: false}, &netlink.Tuntap{Mode: netlink.TUNTAP_MODE_TAP, NonPersist: true}} {
+		if validateTUNLink(link) == nil {
