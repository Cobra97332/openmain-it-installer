+	if forward.Hooknum == nil || *forward.Hooknum != *nftables.ChainHookForward || forward.Type != nftables.ChainTypeFilter {
+		return fmt.Errorf("BINAT native hook changed")
+	}
+	boundary := live["netbird-binat-native"]
+	if boundary.Hooknum == nil || *boundary.Hooknum != *nftables.ChainHookPostrouting || boundary.Priority == nil || *boundary.Priority != nftables.ChainPriority(-201) || boundary.Type != nftables.ChainTypeFilter {
