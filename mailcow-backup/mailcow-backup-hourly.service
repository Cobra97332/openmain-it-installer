[Unit]
Description=Mailcow critical backup (mysql, crypt, redis)
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/mailcow-backup.sh critical
User=root
Group=root
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
