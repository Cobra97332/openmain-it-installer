+		t.Fatal("poisoned gate reopened")
+	}
+}
+
+func TestBINATSmallCanonicalPreservesVerdictAndIgnoresHandles(t *testing.T) {
+	a := `{"nftables":[{"table":{"family":"ip","name":"example"}},{"chain":{"family":"ip","table":"example","name":"ready"}},{"chain":{"family":"ip","table":"example","name":"guard"}},{"rule":{"family":"ip","table":"example","chain":"ready","handle":4,"expr":[{"counter":{"packets":8,"bytes":9}},{"accept":null}]}}]}`
+	x, e := canonical([]byte(a), "example")
+	if e != nil {
+		t.Fatal(e)
+	}
+	b := strings.ReplaceAll(a, `"handle":4`, `"handle":5`)
+	b = strings.ReplaceAll(b, `"packets":8`, `"packets":80`)
+	y, e := canonical([]byte(b), "example")
+	if e != nil || x != y {
+		t.Fatal("volatile state changed ownership comparison")
+	}
+	b = strings.ReplaceAll(a, "accept", "drop")
+	y, _ = canonical([]byte(b), "example")
+	if x == y {
