+// SetSyncDisconnectListener binds the current Engine's local DENY boundary.
+// It never copies policy or opens a gate; only a full NetworkMap can do that.
+func (c *GrpcClient) SetSyncDisconnectListener(listener func(error)) {
+	c.syncStreamMu.Lock()
+	defer c.syncStreamMu.Unlock()
+	c.syncDisconnectListener = listener
