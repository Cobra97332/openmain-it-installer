[Unit]
Description=OpenMain-IT NetBird Router First Boot
After=network-online.target
Wants=network-online.target
ConditionPathExists=!/var/lib/openmain-router-firstboot.done

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/netbird-router-firstboot
StandardInput=tty
StandardOutput=tty
StandardError=tty
TTYPath=/dev/tty1
TTYReset=yes
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
