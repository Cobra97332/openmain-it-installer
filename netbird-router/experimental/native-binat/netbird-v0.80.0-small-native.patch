+//go:build linux && !android
+
+package nftables
+
+import (
+	"github.com/google/nftables/expr"
+	"testing"
+)
+
+func TestBINATSmallNativeOriginalTupleLoads(t *testing.T) {
+	items := []expr.Any{&expr.Payload{Base: expr.PayloadBaseNetworkHeader, Offset: 12, Len: 4, DestRegister: 1}, &expr.Payload{Base: expr.PayloadBaseNetworkHeader, Offset: 16, Len: 4, DestRegister: 1}, &expr.Meta{Key: expr.MetaKeyL4PROTO, Register: 1}, &expr.Payload{Base: expr.PayloadBaseTransportHeader, Offset: 0, Len: 2, DestRegister: 1}, &expr.Payload{Base: expr.PayloadBaseTransportHeader, Offset: 2, Len: 2, DestRegister: 1}, &expr.Verdict{Kind: expr.VerdictDrop}}
+	result := originalRouteTuple(items)
+	expected := []expr.CtKey{expr.CtKeySRC, expr.CtKeyDST, expr.CtKeyPROTOCOL, expr.CtKeyPROTOSRC, expr.CtKeyPROTODST}
+	for i, key := range expected {
+		v, ok := result[i].(*expr.Ct)
+		if !ok || v.Key != key || v.Direction != 0 || v.Register != 1 {
+			t.Fatalf("original tuple load %d wrong", i)
+		}
+	}
+	if result[5].(*expr.Verdict).Kind != expr.VerdictDrop {
+		t.Fatal("DROP changed")
+	}
+}
