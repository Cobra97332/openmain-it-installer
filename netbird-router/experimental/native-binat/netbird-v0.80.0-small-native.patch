+	if _, err := New(good, nil); err != nil {
+		t.Fatal(err)
+	}
+	for _, bad := range [][]Scope{nil, append(good, good...), {{"10.80.1.1/24", "192.168.80.0/24", "nb0", "lan0"}}, {{"10.80.1.0/24", "192.168.80.0/24", "nb0", "nb0"}}} {
