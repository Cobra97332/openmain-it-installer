new file mode 100644
--- /dev/null
+++ b/client/firewall/binat/cmd/lab/main.go
@@ -0,0 +1,102 @@
+//go:build linux
+
+package main
+
+import (
+	"bufio"
+	"encoding/json"
+	"fmt"
+	"github.com/netbirdio/netbird/client/firewall/binat"
+	"net"
+	"os"
+)
+
+func main() {
+	if os.Getenv("OPENMAIN_ISOLATED_TEST") != "1" {
+		panic("isolated lab required")
+	}
+	interfaces, err := net.Interfaces()
+	if err != nil || len(interfaces) != 1 || interfaces[0].Name != "lo" {
+		panic("fresh no-NIC namespace required")
+	}
+	root := binat.Root
+	if err := os.MkdirAll(root, 0700); err != nil {
+		panic("lab config directory")
+	}
+	scopes := []binat.Scope{{Virtual: "10.80.1.0/24", Real: "192.168.80.0/24", Overlay: "nb0", LAN: "lan0"}, {Virtual: "10.81.1.0/24", Real: "192.168.80.0/24", Overlay: "backup0", LAN: "lan0"}}
+	data, _ := json.Marshal(scopes)
+	if os.WriteFile(root+"/config.json", data, 0600) != nil {
+		panic("config write")
+	}
+	os.Setenv("NB_EXPERIMENTAL_BINAT_CONFIG", root+"/config.json")
+	p, err := binat.LoadLabFromEnv()
+	if err != nil {
+		fmt.Println("FAIL bootstrap", err)
+		os.Exit(1)
+	}
+	defer func() {
+		if p != nil {
+			p.Release()
+		}
+	}()
+	encoder := json.NewEncoder(os.Stdout)
+	encoder.Encode(map[string]any{"Ready": true})
+	scanner := bufio.NewScanner(os.Stdin)
+	scanner.Buffer(make([]byte, 4096), 1024*1024)
+	for scanner.Scan() {
+		var r struct {
+			Serial    uint64
+			Rules     []binat.Rule
+			Operation string
+			Digest    string
+		}
+		if json.Unmarshal(scanner.Bytes(), &r) != nil {
+			encoder.Encode(map[string]any{"Error": "input"})
+			continue
+		}
+		switch r.Operation {
+		case "observe":
+			err = p.Observe(r.Serial, r.Digest)
+			encoder.Encode(map[string]any{"Observed": err == nil})
+			continue
+		case "restart":
+			err = p.Close()
+			if err == nil {
+				p.Release()
+				p, err = binat.LoadLabFromEnv()
+			}
+			encoder.Encode(map[string]any{"Restarted": err == nil})
+			if err != nil {
+				os.Exit(1)
+			}
+			continue
+		case "close":
+			err = p.Close()
+			encoder.Encode(map[string]any{"Closed": err == nil})
+			continue
+		case "begin":
+			err = p.Begin(r.Serial, r.Rules)
+			encoder.Encode(map[string]any{"Prepared": err == nil})
+			continue
+		case "commit":
+		case "publish", "":
+			err = p.Begin(r.Serial, r.Rules)
+		default:
+			encoder.Encode(map[string]any{"Error": "operation"})
+			continue
+		}
+		if err != nil {
+			encoder.Encode(map[string]any{"Error": "prepare"})
+			continue
+		}
+		ack, err := p.Commit()
+		if err != nil {
+			encoder.Encode(map[string]any{"Error": "publication"})
+			continue
+		}
+		encoder.Encode(ack)
+	}
+	if err = p.Close(); err != nil {
+		os.Exit(1)
+	}
+}
diff --git a/client/firewall/binat/publisher_linux.go b/client/firewall/binat/publisher_linux.go
new file mode 100644
--- /dev/null
+++ b/client/firewall/binat/publisher_linux.go
@@ -0,0 +1,699 @@
+//go:build linux
+
+// Package binat is experimental, opt-in native policy publication. No controller
+// acknowledgment is inferred from local netlink/nft acknowledgment or readback.
+package binat
+
+import (
+	"bytes"
+	"context"
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"net/netip"
+	"os"
+	"os/exec"
+
+	"regexp"
+	"sort"
+	"strings"
+	"sync"
+	"syscall"
+	"time"
+)
+
+const Table = "netbird_binat_experiment_v3"
+const Root = "/run/netbird-binat-lab"
+
+var ErrUnconfirmed = errors.New("BINAT local closure unconfirmed")
+var names = regexp.MustCompile(`^[a-zA-Z0-9_.-]{1,15}$`)
+var configured struct {
+	sync.RWMutex
+	scopes []Scope
+	active *Publisher
+}
+
+type Scope struct{ Virtual, Real, Overlay, LAN string }
+type Rule struct {
+	Source, Destination, Protocol, Action string
+	Ports                                 [][2]uint16
+}
+type ACK struct {
+	Serial, Epoch              uint64
+	PolicyDigest, KernelDigest string
+	ControllerConfirmed        bool
+}
+type Runner func(string) ([]byte, error)
+type Publisher struct {
+	mutex          sync.Mutex
+	scopes         []Scope
+	run            Runner
+	lock           *os.File
+	guard          string
+	current        string
+	pending        *prepared
+	epoch          uint64
+	released       bool
+	seenSerial     uint64
+	seenDigest     string
+	observedDigest string
+	hasSerial      bool
+	last           *ACK
+}
+type prepared struct {
+	serial, epoch            uint64
+	script, digest, expected string
+}
+
+func hash(b []byte) string { h := sha256.Sum256(b); return hex.EncodeToString(h[:]) }
+
+type boundedOutput struct{ bytes.Buffer }
+
+func (b *boundedOutput) Write(data []byte) (int, error) {
+	if len(data) > 4*1024*1024-b.Len() {
+		return 0, errors.New("BINAT readback exceeds bound")
+	}
+	return b.Buffer.Write(data)
+}
+
+func execute(script string) ([]byte, error) {
+	ctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
+	defer cancel()
+	cmd := exec.CommandContext(ctx, "/usr/sbin/nft", "-s", "-j", "-f", "-")
+	cmd.Stdin = strings.NewReader(script)
+	out := &boundedOutput{}
+	cmd.Stdout = out
+	if len(script) > 2*1024*1024 {
+		return nil, errors.New("BINAT transaction exceeds bound")
+	}
+	if err := cmd.Run(); err != nil {
+		return nil, errors.New("BINAT nft operation failed")
+	}
+	if out.Len() > 4*1024*1024 {
+		return nil, errors.New("BINAT readback exceeds bound")
+	}
+	return out.Bytes(), nil
+}
+func ValidateScopes(items []Scope) error {
+	if len(items) == 0 || len(items) > 16 {
+		return errors.New("BINAT invalid scope count")
+	}
+	for i, s := range items {
+		v, err := netip.ParsePrefix(s.Virtual)
+		if err != nil || !v.Addr().Is4() || v != v.Masked() || v.Bits() < 8 {
+			return errors.New("BINAT invalid virtual prefix")
+		}
+		r, err := netip.ParsePrefix(s.Real)
+		if err != nil || !r.Addr().Is4() || r != r.Masked() || r.Bits() != v.Bits() || r.Overlaps(v) {
+			return errors.New("BINAT invalid real prefix")
+		}
+		if !names.MatchString(s.Overlay) || !names.MatchString(s.LAN) || s.Overlay == s.LAN {
+			return errors.New("BINAT invalid interface")
+		}
+		for _, prior := range items[:i] {
+			n, _ := netip.ParsePrefix(prior.Virtual)
+			if n.Overlaps(v) {
+				return errors.New("BINAT ambiguous scope")
+			}
+		}
+	}
+	return nil
+}
+
+// CloseActive is the synchronous lifecycle barrier used before native firewall
+// destruction/rebuild. Copy the owner under the registry lock, never hold that
+// lock during kernel IO or acquire locks in the reverse order of Release.
+func CloseActive() error {
+	configured.RLock()
+	p := configured.active
+	configured.RUnlock()
+	if p == nil {
+		if os.Getenv("NB_EXPERIMENTAL_BINAT_CONFIG") != "" {
+			return ErrUnconfirmed
+		}
+		return nil
+	}
+	return p.Close()
+}
+
+func OriginalDestination(prefix netip.Prefix) bool {
+	configured.RLock()
+	defer configured.RUnlock()
+	for _, s := range configured.scopes {
+		v, _ := netip.ParsePrefix(s.Virtual)
+		if prefix.Addr().Is4() && v.Contains(prefix.Addr()) && prefix.Bits() >= v.Bits() {
+			return true
+		}
+	}
+	return false
+}
+func New(items []Scope, runner Runner) (*Publisher, error) {
+	if err := ValidateScopes(items); err != nil {
+		return nil, err
+	}
+	if runner == nil {
+		runner = execute
+	}
+	return &Publisher{scopes: append([]Scope(nil), items...), run: runner}, nil
+}
+func privateFile(path string) ([]byte, error) {
+	f, err := os.OpenFile(path, os.O_RDONLY|syscall.O_NOFOLLOW, 0)
+	if err != nil {
+		return nil, errors.New("BINAT protected file missing")
+	}
+	defer f.Close()
+	st, err := f.Stat()
+	if err != nil || !st.Mode().IsRegular() || st.Mode().Perm() != 0600 || st.Sys().(*syscall.Stat_t).Uid != 0 || st.Size() > 1024*1024 {
+		return nil, errors.New("BINAT protected file unsafe")
+	}
+	b, err := io.ReadAll(io.LimitReader(f, 1024*1024+1))
+	if err != nil || int64(len(b)) != st.Size() {
+		return nil, errors.New("BINAT protected read incomplete")
+	}
+	return b, nil
+}
+func LoadLabFromEnv() (*Publisher, error) {
+	value := os.Getenv("NB_EXPERIMENTAL_BINAT_CONFIG")
+	if value == "" {
+		return nil, nil
+	}
+	if value != Root+"/config.json" || os.Getenv("OPENMAIN_ISOLATED_TEST") != "1" {
+		return nil, errors.New("BINAT requires explicit isolated lab config")
+	}
+	if strings.HasPrefix(os.Getenv("NB_NFTABLES_TABLE"), Table) {
+		return nil, errors.New("BINAT native table ownership collision")
+	}
+	st, err := os.Lstat(Root)
+	if err != nil || !st.IsDir() || st.Mode().Perm() != 0700 || st.Sys().(*syscall.Stat_t).Uid != 0 {
+		return nil, errors.New("BINAT lab directory unsafe")
+	}
+	data, err := privateFile(value)
+	if err != nil {
+		return nil, err
+	}
+	var items []Scope
+	dec := json.NewDecoder(bytes.NewReader(data))
+	dec.DisallowUnknownFields()
+	if err := dec.Decode(&items); err != nil {
+		return nil, errors.New("BINAT config invalid")
+	}
+	if dec.Decode(&struct{}{}) != io.EOF {
+		return nil, errors.New("BINAT config trailing data")
+	}
+	p, err := New(items, nil)
+	if err != nil {
+		return nil, err
+	}
+	f, err := os.OpenFile(Root+"/owner.lock", os.O_CREATE|os.O_RDWR|syscall.O_NOFOLLOW, 0600)
+	if err != nil {
+		return nil, errors.New("BINAT ownership unavailable")
+	}
+	info, err := f.Stat()
+	if err != nil || !info.Mode().IsRegular() || info.Mode().Perm() != 0600 || info.Sys().(*syscall.Stat_t).Uid != 0 {
+		f.Close()
+		return nil, errors.New("BINAT owner lock unsafe")
+	}
+	if err := syscall.Flock(int(f.Fd()), syscall.LOCK_EX|syscall.LOCK_NB); err != nil {
+		f.Close()
+		return nil, errors.New("BINAT owner busy")
+	}
+	p.lock = f
+	if err := p.Bootstrap(); err != nil {
+		f.Close()
+		return nil, err
+	}
+	configured.Lock()
+	configured.scopes = append([]Scope(nil), items...)
+	configured.active = p
+	configured.Unlock()
+	return p, nil
+}
+
+// Rule fingerprints omit volatile handles/counters but retain complete selectors,
+// verdicts and ownership comments. No raw nft response is logged.
+func fingerprint(data []byte, chain string) (string, error) {
+	var envelope struct {
+		NFTables []map[string]json.RawMessage `json:"nftables"`
+	}
+	if err := json.Unmarshal(data, &envelope); err != nil {
+		return "", errors.New("BINAT invalid kernel readback")
+	}
+	var rules []any
+	for _, entry := range envelope.NFTables {
+		raw, ok := entry["rule"]
+		if !ok {
+			continue
+		}
+		var rule map[string]any
+		if json.Unmarshal(raw, &rule) != nil {
+			return "", errors.New("BINAT invalid rule")
+		}
+		if rule["chain"] != chain {
+			continue
+		}
+		delete(rule, "handle")
+		delete(rule, "table")
+		delete(rule, "family")
+		delete(rule, "chain")
+		if exprs, ok := rule["expr"].([]any); ok {
+			for _, item := range exprs {
+				if expr, ok := item.(map[string]any); ok {
+					if _, ok := expr["counter"]; ok {
+						expr["counter"] = map[string]any{}
+					}
+				}
+			}
+		}
+		rules = append(rules, rule)
+	}
+	if rules == nil {
+		rules = []any{}
+	}
+	b, _ := json.Marshal(rules)
+	return hash(b), nil
+}
+func (p *Publisher) read(chain string) (string, error) {
+	b, err := p.run("list chain ip " + Table + " " + chain + "\n")
+	if err != nil {
+		return "", err
+	}
+	if chain == "guard" {
+		var envelope struct {
+			NFTables []map[string]json.RawMessage `json:"nftables"`
+		}
+		if json.Unmarshal(b, &envelope) != nil {
+			return "", ErrUnconfirmed
+		}
+		valid := false
+		for _, entry := range envelope.NFTables {
+			if raw, ok := entry["chain"]; ok {
+				var c struct {
+					Name, Type, Hook, Policy string
+					Prio                     int
+				}
+				if json.Unmarshal(raw, &c) == nil && c.Name == "guard" {
+					valid = c.Type == "filter" && c.Hook == "postrouting" && c.Policy == "accept" && c.Prio == -200
+				}
+			}
+		}
+		if !valid {
+			return "", ErrUnconfirmed
+		}
+	}
+	return fingerprint(b, chain)
+}
+func (p *Publisher) guardRules(table string) string {
+	var b strings.Builder
+	for _, s := range p.scopes {
+		// Without a tuple NAT cannot translate the virtual destination. Close
+		// that explicitly reserved header path as well; do not blanket-drop
+		// unrelated direct real-LAN policies whose original scope is unknown.
+		fmt.Fprintf(&b, "add rule ip %s guard ip daddr %s ct state invalid,untracked counter drop\n", table, s.Virtual)
+		base := "ct original ip daddr " + s.Virtual
+		fmt.Fprintf(&b, "add rule ip %s guard %s ct state invalid,untracked counter drop\n", table, base)
+		fmt.Fprintf(&b, "add rule ip %s guard %s ct direction original iifname %q oifname %q ip daddr %s jump current\n", table, base, s.Overlay, s.LAN, s.Real)
+		fmt.Fprintf(&b, "add rule ip %s guard %s ct direction reply iifname %q oifname %q ip saddr %s jump current\n", table, base, s.LAN, s.Overlay, s.Real)
+		fmt.Fprintf(&b, "add rule ip %s guard %s counter drop\n", table, base)
+	}
+	return b.String()
+}
+func (p *Publisher) Bootstrap() error {
+	p.mutex.Lock()
+	defer p.mutex.Unlock()
+	out, err := p.run("list ruleset\n")
+	if err != nil {
+		return errors.New("BINAT offload admission unconfirmed")
+	}
+	var ruleset struct {
+		NFTables []map[string]json.RawMessage `json:"nftables"`
+	}
+	if json.Unmarshal(out, &ruleset) != nil {
+		return errors.New("BINAT ruleset admission invalid")
+	}
+	for _, obj := range ruleset.NFTables {
+		if _, found := obj["flowtable"]; found {
+			return errors.New("BINAT flow offload unsupported")
+		}
+	}
+	// A receipt authorizes adoption only of the same protected lab configuration
+	// and previously verified guard. Unknown existing tables are never overwritten.
+	candidate := Table + "_candidate"
+	script := "create table ip " + candidate + "\nadd chain ip " + candidate + " current\nadd chain ip " + candidate + " guard\n" + p.guardRules(candidate)
+	out, err = p.run(script)
+	if err != nil {
+		return err
+	}
+	defer p.run("delete table ip " + candidate + "\n")
+	out, err = p.run("list chain ip " + candidate + " guard\n")
+	if err != nil {
+		return err
+	}
+	expected, err := fingerprint(out, "guard")
+	if err != nil {
+		return err
+	}
+	p.guard = expected
+	existing, readErr := p.read("guard")
+	if readErr == nil {
+		receipt, err := privateFile(Root + "/receipt.json")
+		if err != nil {
+			return errors.New("BINAT unknown existing table")
+		}
+		var state struct {
+			Scope, Guard, Current string
+			Serial, Epoch         uint64
+			HasSerial             bool
+			PolicyDigest          string
+			ObservedDigest        string
+		}
+		if json.Unmarshal(receipt, &state) != nil {
+			return errors.New("BINAT invalid receipt")
+		}
+		cfg, _ := json.Marshal(p.scopes)
+		if state.Scope != hash(cfg) || state.Guard != expected || existing != expected {
+			return errors.New("BINAT existing guard mismatch")
+		}
+		live, err := p.read("current")
+		if err != nil || (live != state.Current && live != hash([]byte("[]"))) {
+			return errors.New("BINAT existing policy modified")
+		}
+		p.current = live
+		p.seenSerial, p.hasSerial, p.seenDigest, p.epoch = state.Serial, state.HasSerial, state.PolicyDigest, state.Epoch
+		p.observedDigest = state.ObservedDigest
+		for _, digest := range []string{p.seenDigest, p.observedDigest} {
+			if digest != "" {
+				if _, err := hex.DecodeString(digest); err != nil || len(digest) != 64 || !p.hasSerial {
+					return errors.New("BINAT receipt policy invalid")
+				}
+			}
+		}
+	} else {
+		_, err = p.run("create table ip " + Table + "\nadd chain ip " + Table + " current\nadd chain ip " + Table + " guard { type filter hook postrouting priority -200; policy accept; }\n" + p.guardRules(Table))
+		if err != nil {
+			return err
+		}
+	}
+	return p.closeLocked()
+}
+func (p *Publisher) receipt() error {
+	if p.lock == nil {
+		return nil
+	} // explicitly isolated test runner, not engine adoption
+	cfg, _ := json.Marshal(p.scopes)
+	b, _ := json.Marshal(struct {
+		Scope, Guard, Current string
+		Serial, Epoch         uint64
+		HasSerial             bool
+		PolicyDigest          string
+		ObservedDigest        string
+	}{hash(cfg), p.guard, p.current, p.seenSerial, p.epoch, p.hasSerial, p.seenDigest, p.observedDigest})
+	f, err := os.CreateTemp(Root, "receipt-")
+	if err != nil {
+		return errors.New("BINAT receipt unavailable")
+	}
+	name := f.Name()
+	defer os.Remove(name)
+	if err = f.Chmod(0600); err == nil {
+		_, err = f.Write(b)
+	}
+	if err == nil {
+		err = f.Sync()
+	}
+	f.Close()
+	if err != nil {
+		return errors.New("BINAT receipt write failed")
+	}
+	if err = os.Rename(name, Root+"/receipt.json"); err != nil {
+		return errors.New("BINAT receipt commit failed")
+	}
+	d, err := os.Open(Root)
+	if err != nil {
+		return errors.New("BINAT receipt directory unavailable")
+	}
+	defer d.Close()
+	if d.Sync() != nil {
+		return errors.New("BINAT receipt directory sync failed")
+	}
+	return nil
+}
+func (p *Publisher) closeLocked() error {
+	allowedPrepared := ""
+	if p.pending != nil {
+		allowedPrepared = p.pending.expected
+	}
+	p.pending = nil
+	p.last = nil
+	p.epoch++
+	live, err := p.read("guard")
+	if err != nil || live != p.guard {
+		return fmt.Errorf("%w: guard-readback", ErrUnconfirmed)
+	}
+	current, readErr := p.read("current")
+	if readErr != nil || (current != p.current && current != allowedPrepared && current != hash([]byte("[]"))) {
+		return fmt.Errorf("%w: policy-ownership", ErrUnconfirmed)
+	}
+	if _, err = p.run("flush chain ip " + Table + " current\n"); err != nil {
+		return fmt.Errorf("%w: close-transaction", ErrUnconfirmed)
+	}
+	digest, err := p.read("current")
+	if err != nil || digest != hash([]byte("[]")) {
+		return fmt.Errorf("%w: close-readback", ErrUnconfirmed)
+	}
+	p.current = digest
+	if p.receipt() != nil {
+		return fmt.Errorf("%w: receipt", ErrUnconfirmed)
+	}
+	return nil
+}
+func (p *Publisher) Close() error {
+	p.mutex.Lock()
+	defer p.mutex.Unlock()
+	if p.released {
+		return errors.New("BINAT publisher released")
+	}
+	return p.closeLocked()
+}
+func (p *Publisher) Release() {
+	p.mutex.Lock()
+	defer p.mutex.Unlock()
+	p.released = true
+	p.pending = nil
+	p.last = nil
+	configured.Lock()
+	if configured.active == p {
+		configured.active = nil
+		configured.scopes = nil
+	}
+	configured.Unlock()
+	if p.lock != nil {
+		p.lock.Close()
+		p.lock = nil
+	}
+}
+func Compile(scopes []Scope, rules []Rule) (string, error) {
+	if len(rules) > 256 {
+		return "", errors.New("BINAT too many rules")
+	}
+	rows := append([]Rule(nil), rules...)
+	sort.SliceStable(rows, func(i, j int) bool {
+		if rows[i].Action != rows[j].Action {
+			return rows[i].Action == "drop"
+		}
+		a, _ := json.Marshal(rows[i])
+		b, _ := json.Marshal(rows[j])
+		return bytes.Compare(a, b) < 0
+	})
+	b, _ := json.Marshal(rows)
+	digest := hash(b)
+	var out strings.Builder
+	for _, r := range rows {
+		source, err := netip.ParsePrefix(r.Source)
+		if err != nil || !source.Addr().Is4() || source != source.Masked() {
+			return "", errors.New("BINAT invalid source")
+		}
+		dest, err := netip.ParsePrefix(r.Destination)
+		if err != nil || !dest.Addr().Is4() || dest != dest.Masked() {
+			return "", errors.New("BINAT invalid destination")
+		}
+		contained := false
+		for _, s := range scopes {
+			v, _ := netip.ParsePrefix(s.Virtual)
+			if v.Contains(dest.Addr()) && dest.Bits() >= v.Bits() {
+				contained = true
+			}
+		}
+		if !contained {
+			return "", errors.New("BINAT destination outside scope")
+		}
+		if r.Action != "accept" && r.Action != "drop" {
+			return "", errors.New("BINAT action unsupported")
+		}
+		if r.Protocol != "all" && r.Protocol != "tcp" && r.Protocol != "udp" && r.Protocol != "icmp" {
+			return "", errors.New("BINAT protocol unsupported")
+		}
+		if len(r.Ports) > 32 || len(r.Ports) > 0 && (r.Protocol != "tcp" && r.Protocol != "udp") {
+			return "", errors.New("BINAT invalid ports")
+		}
+		match := "ct original ip saddr " + source.String() + " ct original ip daddr " + dest.String()
+		if r.Protocol != "all" {
+			match += " ct protocol " + r.Protocol
+		}
+		ranges := r.Ports
+		if len(ranges) == 0 {
+			ranges = [][2]uint16{{0, 0}}
+		}
+		for _, ports := range ranges {
+			expr := match
+			if len(r.Ports) > 0 {
+				if ports[0] == 0 || ports[1] < ports[0] {
+					return "", errors.New("BINAT invalid port range")
+				}
+				expr += fmt.Sprintf(" ct original proto-dst %d-%d", ports[0], ports[1])
+			}
+			fmt.Fprintf(&out, "add rule ip %s current %s counter %s comment %q\n", Table, expr, r.Action, "nb-binat-"+digest)
+		}
+	}
+	return out.String(), nil
+}
+
+// Observe binds the received authoritative policy BEFORE semantic parsing.
+// Unsupported/partial newer maps cannot be followed by a lower serial or a
+// contradictory same-serial policy, including after protected owner reload.
+func (p *Publisher) Observe(serial uint64, digest string) error {
+	p.mutex.Lock()
+	defer p.mutex.Unlock()
+	if p.released {
+		return ErrUnconfirmed
+	}
+	if err := p.closeLocked(); err != nil {
+		return err
+	}
+	if len(digest) != 64 {
+		return errors.New("BINAT invalid observation digest")
+	}
+	if _, err := hex.DecodeString(digest); err != nil {
+		return errors.New("BINAT invalid observation digest")
+	}
+	if p.hasSerial && serial < p.seenSerial {
+		return errors.New("BINAT stale observation")
+	}
+	if p.hasSerial && serial == p.seenSerial && p.observedDigest != "" && digest != p.observedDigest {
+		return errors.New("BINAT contradictory observation")
+	}
+	if !p.hasSerial || serial > p.seenSerial {
+		p.seenDigest = ""
+	}
+	p.hasSerial, p.seenSerial, p.observedDigest = true, serial, digest
+	return p.receipt()
+}
+
+func (p *Publisher) Begin(serial uint64, rules []Rule) error {
+	p.mutex.Lock()
+	defer p.mutex.Unlock()
+	if p.released {
+		return errors.New("BINAT publisher released")
+	}
+	if err := p.closeLocked(); err != nil {
+		return err
+	}
+	if p.hasSerial && serial < p.seenSerial {
+		return errors.New("BINAT stale serial")
+	}
+	if !p.hasSerial || serial > p.seenSerial {
+		p.hasSerial = true
+		p.seenSerial = serial
+		p.seenDigest = ""
+		p.observedDigest = ""
+		if err := p.receipt(); err != nil {
+			return err
+		}
+	}
+	script, err := Compile(p.scopes, rules)
+	if err != nil {
+		return err
+	}
+	digest := hash([]byte(script))
+	if p.hasSerial && serial == p.seenSerial && p.seenDigest != "" && digest != p.seenDigest {
+		return errors.New("BINAT contradictory serial")
+	}
+	p.hasSerial = true
+	p.seenSerial = serial
+	p.seenDigest = digest
+	if err := p.receipt(); err != nil {
+		return err
+	}
+	candidate := Table + "_prepared"
+	data, err := p.run("create table ip " + candidate + "\nadd chain ip " + candidate + " current\n" + strings.ReplaceAll(script, Table, candidate))
+	if err != nil {
+		return err
+	}
+	defer p.run("delete table ip " + candidate + "\n")
+	data, err = p.run("list chain ip " + candidate + " current\n")
+	if err != nil {
+		return err
+	}
+	expected, err := fingerprint(data, "current")
+	if err != nil {
+		return err
+	}
+	p.pending = &prepared{serial, p.epoch, script, hash([]byte(script)), expected}
+	return nil
+}
+func (p *Publisher) Commit() (ACK, error) {
+	p.mutex.Lock()
+	defer p.mutex.Unlock()
+	next := p.pending
+	if p.released || next == nil || next.epoch != p.epoch {
+		return ACK{}, errors.New("BINAT stale publication")
+	}
+	success := false
+	defer func() {
+		if !success {
+			p.closeLocked()
+		}
+	}()
+	if live, err := p.read("guard"); err != nil || live != p.guard {
+		return ACK{}, ErrUnconfirmed
+	}
+	_, err := p.run("flush chain ip " + Table + " current\n" + next.script)
+	if err == nil {
+		var digest string
+		digest, err = p.read("current")
+		if err == nil && digest != next.expected {
+			err = errors.New("BINAT publication readback mismatch")
+		}
+		if err == nil {
+			p.current = digest
+		}
+	}
+	if err != nil {
+		if p.closeLocked() != nil {
+			return ACK{}, ErrUnconfirmed
+		}
+		return ACK{}, errors.New("BINAT publication failed; closure confirmed")
+	}
+	if p.receipt() != nil {
+		if p.closeLocked() != nil {
+			return ACK{}, ErrUnconfirmed
+		}
+		return ACK{}, errors.New("BINAT receipt failed; closure confirmed")
+	}
+	ack := ACK{Serial: next.serial, Epoch: p.epoch, PolicyDigest: next.digest, KernelDigest: p.current}
+	p.last = &ack
+	p.pending = nil
+	success = true
+	return ack, nil
+}
+func (p *Publisher) Scopes() []Scope { return append([]Scope(nil), p.scopes...) }
+func (p *Publisher) LastACK() *ACK {
+	p.mutex.Lock()
+	defer p.mutex.Unlock()
+	if p.last == nil {
+		return nil
+	}
+	v := *p.last
+	return &v
+}
