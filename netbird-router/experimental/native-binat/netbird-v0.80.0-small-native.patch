+package internal
+
+import (
+	"github.com/netbirdio/netbird/client/firewall/binat"
+	fw "github.com/netbirdio/netbird/client/firewall/manager"
+	"github.com/netbirdio/netbird/client/firewall/nftables"
+)
+
+func isBINATNativeFirewall(f fw.Manager) bool { _, ok := f.(*nftables.Manager); return ok }
+
+func confirmBINATNativeFirewall(f fw.Manager) error {
+	native, ok := f.(*nftables.Manager)
+	if !ok {
+		return binat.ErrUnconfirmed
+	}
+	return native.ConfirmBINATNativeRules()
+}
