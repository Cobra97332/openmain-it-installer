# NO credentials here. Copy to a private per-router project directory.
COMPOSE_PROJECT_NAME=om-demo-primary
CUSTOMER=demo
ROUTER_ROLE=primary
# Set backup for second router; existing resource and metric 200 are reused.
VIRTUAL_NETWORK=10.30.1.0/24
LAN_NETWORK_CIDR=192.168.178.0/24
LAN_IP=192.168.178.2
# Backup requires a DIFFERENT transit subnet and distinct unused LAN_IP.
TRANSIT_SUBNET=172.28.250.0/29
EDGE_IP=172.28.250.2
NAT_IP=172.28.250.3
LAN_DOCKER_NETWORK=om-demo-isolated-lan
NB_MANAGEMENT_URL=https://netbird.lab.test
# HTTPS remains the default. The only HTTP exception is:
# http://100.107.91.6:8083/api_jsonrpc.php (NB_ZABBIX_SERVER=100.107.91.6).
# Requires connected NetBird, verified tunnel route; no HTTP proxy/redirects.
NB_ZABBIX_API_URL=https://zabbix.lab.test/api_jsonrpc.php
NB_ZABBIX_SERVER=100.64.0.10
NB_ZABBIX_PROXY_GROUP=Zabbix-Kunden-Proxies
NB_ZABBIX_POLICY_NAME=Zabbix Proxy to Server
SECRETS_DIR=/absolute/private/path/demo-primary
# Public CA bundle, optionally containing the synthetic lab/self-hosted CA.
CA_BUNDLE_FILE=/etc/ssl/certs/ca-certificates.crt
# Official unmodified client; pin a verified multiarch digest before release.
NETBIRD_IMAGE=netbirdio/netbird:0.82.0@sha256:eca5b274c635bfbb04ec6724a0712d1146190dd450eea199eeb83916fdd94965
ROUTER_IMAGE=openmain-router:local
