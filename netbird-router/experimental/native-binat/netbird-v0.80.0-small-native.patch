+	for _, text := range []string{`{}`, `{"nftables":[]}`, `{"nftables":[{"table":{"family":"ip","name":"example"}}]}`, `{"nftables":[{"set":{}}]}`} {
+		if _, err := canonical([]byte(text), "example"); err == nil {
