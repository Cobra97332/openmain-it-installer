# Copy to /opt/netbox/env/sync.env (chmod 600)
ZABBIX_URL=https://zabbix.openmain-it.de
ZABBIX_TOKEN=REPLACE_WITH_ZABBIX_API_TOKEN
NETBOX_URL=http://127.0.0.1:8080
NETBOX_TOKEN=REPLACE_WITH_NETBOX_API_TOKEN
NETBOX_SITE_SLUG=zabbix-import
NETBOX_SITE_NAME=Zabbix Import (Unclassified)
SYNC_INTERVAL_SECONDS=900
DRY_RUN=true
VERIFY_TLS=true
