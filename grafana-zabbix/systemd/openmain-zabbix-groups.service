[Unit]
Description=OpenMain Zabbix Hostgruppen synchronisieren
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/etc/openmain-zabbix-metadata.env
ExecStart=/opt/openmain-grafana-zabbix/sync-zabbix-groups.py
User=root
Group=root
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict

[Install]
WantedBy=multi-user.target
