+func (m *Manager) ConfirmBINATNativeRules() error {
+	m.mutex.Lock()
+	defer m.mutex.Unlock()
+	chains, err := m.rConn.ListChains()
+	if err != nil {
+		return fmt.Errorf("BINAT native chain readback failed")
+	}
+	live := make(map[string]*nftables.Chain)
+	for _, chain := range chains {
+		if chain.Table != nil && chain.Table.Name == m.family4.workTable.Name && chain.Table.Family == nftables.TableFamilyIPv4 {
