+	if err != nil || ack.Serial != 2 || ack.ControllerConfirmed || len(ack.KernelDigest) != 64 {
+		t.Fatal("local ACK missing")
+	}
+	p.Close()
+	if p.LastACK() != nil {
+		t.Fatal("closed ACK retained")
+	}
+	if err := p.Begin(1, []Rule{testRule}); err == nil {
+		t.Fatal("old serial accepted")
+	}
+	if err := p.Begin(3, []Rule{testRule}); err != nil {
+		t.Fatal(err)
+	}
+	p.Close()
+	if _, err = p.Commit(); err == nil {
+		t.Fatal("stale commit reopened")
+	}
+}
+func TestBINATNativeIndeterminateCommitReclosesOrReportsUnconfirmed(t *testing.T) {
+	for _, fail := range []bool{false, true} {
+		f := &fixture{loseACK: true, failClose: fail}
+		p := publisherForFixture(f)
+		if err := p.Begin(1, []Rule{testRule}); err != nil {
+			t.Fatal(err)
+		}
+		_, err := p.Commit()
+		if err == nil || p.LastACK() != nil {
+			t.Fatal("failed publication confirmed")
+		}
+		if fail {
+			if !errors.Is(err, ErrUnconfirmed) {
+				t.Fatal("unconfirmed closure hidden")
+			}
+		} else if f.open {
+			t.Fatal("committed grant retained after ACK loss")
+		}
+	}
+}
+func TestBINATNativeScopeBindingExcludesBroaderAndUnrelatedPrefixes(t *testing.T) {
+	configured.Lock()
+	configured.scopes = testScopes
+	configured.Unlock()
+	defer func() { configured.Lock(); configured.scopes = nil; configured.Unlock() }()
+	if !OriginalDestination(netip.MustParsePrefix("10.80.1.20/32")) || OriginalDestination(netip.MustParsePrefix("0.0.0.0/0")) || OriginalDestination(netip.MustParsePrefix("192.168.80.0/24")) {
+		t.Fatal("native match scope escaped")
+	}
+}
+
+func TestBINATNativeLifecycleCloseInvalidatesPendingAndACK(t *testing.T) {
+	f := &fixture{}
+	p := publisherForFixture(f)
+	configured.Lock()
+	configured.active = p
+	configured.Unlock()
+	defer p.Release()
+	if err := p.Begin(9, []Rule{testRule}); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := p.Commit(); err != nil {
+		t.Fatal(err)
+	}
+	if err := CloseActive(); err != nil || f.open || p.LastACK() != nil {
+		t.Fatal("native reset retained authorization")
+	}
+	if err := p.Begin(10, []Rule{testRule}); err != nil {
+		t.Fatal(err)
+	}
+	if err := CloseActive(); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := p.Commit(); err == nil {
+		t.Fatal("publication crossed native reset")
+	}
+	p.Release()
+	if err := p.Close(); err == nil {
+		t.Fatal("released old owner accepted lifecycle action")
+	}
+}
+func TestBINATNativeInvalidNewerMapCannotRestoreOlderSerial(t *testing.T) {
+	f := &fixture{}
+	p := publisherForFixture(f)
+	if err := p.Begin(12, []Rule{{Action: "unsupported"}}); err == nil {
+		t.Fatal("invalid map accepted")
+	}
+	if err := p.Begin(11, []Rule{testRule}); err == nil || f.open {
+		t.Fatal("older snapshot restored after rejection")
+	}
+	if err := p.Begin(12, []Rule{testRule}); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := p.Commit(); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func TestBINATNativeConfiguredWithoutOwnerRefusesFirewallDestruction(t *testing.T) {
+	t.Setenv("NB_EXPERIMENTAL_BINAT_CONFIG", Root+"/config.json")
+	configured.RLock()
+	active := configured.active
+	configured.RUnlock()
+	if active != nil {
+		t.Fatal("unexpected owner in isolated fixture")
+	}
+	if !errors.Is(CloseActive(), ErrUnconfirmed) {
+		t.Fatal("ownerless reset accepted")
+	}
+}
+
+func TestBINATNativeReleaseRestoresStockAndPreservesNewOwner(t *testing.T) {
+	p := publisherForFixture(&fixture{})
+	configured.Lock()
+	configured.active = p
+	configured.scopes = testScopes
+	configured.Unlock()
+	target := netip.MustParsePrefix("10.80.1.20/32")
+	if !OriginalDestination(target) {
+		t.Fatal("configured scoped rewrite absent")
+	}
+	p.Release()
+	if OriginalDestination(target) || p.LastACK() != nil {
+		t.Fatal("released publisher affects stock ACL generation")
+	}
+	next := publisherForFixture(&fixture{})
+	configured.Lock()
+	configured.active = next
+	configured.scopes = testScopes
+	configured.Unlock()
+	defer next.Release()
+	p.Release()
+	if !OriginalDestination(target) {
+		t.Fatal("old owner removed new owner's configuration")
+	}
+}
+
+func TestBINATNativeRejectedObservedMapCannotRestoreOlderOrContradictoryPolicy(t *testing.T) {
+	f := &fixture{}
+	p := publisherForFixture(f)
+	if err := p.Begin(10, []Rule{testRule}); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := p.Commit(); err != nil {
+		t.Fatal(err)
+	}
+	// The adapter subsequently rejects this newer map before Begin is possible.
+	if err := p.Observe(20, hash([]byte("unsupported full map"))); err != nil || f.open {
+		t.Fatal("observation did not close")
+	}
+	if err := p.Begin(19, []Rule{testRule}); err == nil {
+		t.Fatal("older map restored after parser rejection")
+	}
+	if err := p.Observe(20, hash([]byte("different policy"))); err == nil || f.open {
+		t.Fatal("same-serial contradiction accepted")
+	}
+	if err := p.Observe(21, hash([]byte("current complete map"))); err != nil {
+		t.Fatal(err)
+	}
+	if err := p.Begin(21, []Rule{testRule}); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := p.Commit(); err != nil {
+		t.Fatal(err)
+	}
+}
