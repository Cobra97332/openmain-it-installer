+++ b/client/firewall/binat/cmd/ct-readback/main.go
@@ -0,0 +1,48 @@
+// Real kernel ABI proof, not an Engine/controller or packet authorization proof.
+package main
+
+import (
+	"fmt"
+	nft "github.com/google/nftables"
+	"github.com/google/nftables/expr"
+	"net"
+	"os"
+)
+
+func main() {
+	ifaces, err := net.Interfaces()
+	if err != nil || os.Getenv("OPENMAIN_ISOLATED_TEST") != "1" || len(ifaces) != 1 || ifaces[0].Name != "lo" {
+		panic("isolated network-none namespace required")
+	}
+	c := &nft.Conn{}
+	table := c.AddTable(&nft.Table{Name: "lab_binat_ct_readback", Family: nft.TableFamilyIPv4})
+	chain := c.AddChain(&nft.Chain{Name: "probe", Table: table})
+	for _, dir := range []uint32{0, 1} {
+		for _, key := range []expr.CtKey{expr.CtKeySRC, expr.CtKeyDST, expr.CtKeyPROTOSRC, expr.CtKeyPROTODST} {
+			name := fmt.Sprintf("synthetic-%d-%d", dir, key)
+			c.AddRule(&nft.Rule{Table: table, Chain: chain, UserData: []byte(name), Exprs: []expr.Any{&expr.Ct{Key: key, Register: 1, Direction: dir}, &expr.Verdict{Kind: expr.VerdictDrop}}})
+		}
+	}
+	if err := c.Flush(); err != nil {
+		panic(fmt.Errorf("synthetic kernel installation failed: %w", err))
+	}
+	defer func() {
+		c.DelTable(table)
+		if c.Flush() != nil {
+			panic("synthetic cleanup failed")
+		}
+	}()
+	rows, err := c.GetRules(table, chain)
+	if err != nil || len(rows) != 8 {
+		panic("mandatory conntrack kernel readback failed")
+	}
+	seen := map[string]bool{}
+	for _, row := range rows {
+		ct, ok := row.Exprs[0].(*expr.Ct)
+		if !ok || ct.Register != 1 || ct.Direction > 1 || row.Handle == 0 || string(row.UserData) != fmt.Sprintf("synthetic-%d-%d", ct.Direction, ct.Key) || seen[string(row.UserData)] {
+			panic("kernel tuple/identity metadata changed")
+		}
+		seen[string(row.UserData)] = true
+	}
+	fmt.Println("PASS: actual kernel original/reply address/port readback, stable UserData and handles; not full Engine authorization")
+}
diff --git a/client/firewall/binat/cmd/small-lab/main.go b/client/firewall/binat/cmd/small-lab/main.go
new file mode 100644
--- /dev/null
+++ b/client/firewall/binat/cmd/small-lab/main.go
@@ -0,0 +1,192 @@
+//go:build linux
+
+package main
+
+import (
+	"bufio"
+	"encoding/base64"
+	"encoding/binary"
+	"encoding/json"
+	"fmt"
+	"github.com/netbirdio/netbird/client/firewall/binat"
+	"net"
+	"os"
+	"strings"
+	"syscall"
+	"unsafe"
+)
+
+func main() {
+	if os.Getenv("OPENMAIN_SMALL_NO_CONFIG_PROBE") == "1" {
+		if os.Getenv("OPENMAIN_ISOLATED_TEST") != "1" {
+			panic("isolated read-only probe required")
+		}
+		os.Unsetenv("NB_EXPERIMENTAL_BINAT_CONFIG")
+		candidate, err := binat.LoadLabFromEnv()
+		if candidate != nil {
+			panic("unconfigured probe activated a gate")
+		}
+		json.NewEncoder(os.Stdout).Encode(map[string]bool{"Refused": err != nil})
+		return
+	}
+	interfaces, err := net.Interfaces()
+	if os.Getenv("OPENMAIN_ISOLATED_TEST") != "1" || err != nil || len(interfaces) != 1 || interfaces[0].Name != "lo" {
+		panic("fresh isolated lab required")
+	}
+	if os.MkdirAll(binat.Root, 0700) != nil {
+		panic("lab root")
+	}
+	scopes := []binat.Scope{{Virtual: "10.80.1.0/24", Real: "192.168.80.0/24", Overlay: "nb0", LAN: "lan0"}, {Virtual: "10.81.1.0/24", Real: "192.168.80.0/24", Overlay: "backup0", LAN: "lan0"}}
+	data, _ := json.Marshal(scopes)
+	if os.WriteFile(binat.Root+"/config.json", data, 0600) != nil {
+		panic("config")
+	}
+	os.Setenv("NB_EXPERIMENTAL_BINAT_CONFIG", binat.Root+"/config.json")
+	g, err := binat.LoadLabFromEnv()
+	if err != nil {
+		fmt.Println("bootstrap refused")
+		os.Exit(1)
+	}
+	defer func() {
+		if g != nil {
+			g.Close()
+			g.Release()
+		}
+	}()
+	out := json.NewEncoder(os.Stdout)
+	out.Encode(map[string]bool{"Ready": true})
+	var tun *os.File
+	var transport net.PacketConn
+	defer func() {
+		if transport != nil {
+			transport.Close()
+		}
+	}()
+	defer func() {
+		if tun != nil {
+			tun.Close()
+		}
+	}()
+	var pending uint64
+	scanner := bufio.NewScanner(os.Stdin)
+	for scanner.Scan() {
+		stage := "operation"
+		if strings.HasPrefix(scanner.Text(), "inject ") {
+			data, decodeErr := base64.StdEncoding.DecodeString(strings.TrimPrefix(scanner.Text(), "inject "))
+			ok := decodeErr == nil && tun != nil && len(data) > 20 && len(data) < 4096
+			if ok {
+				_, err = tun.Write(data)
+				ok = err == nil
+			}
+			out.Encode(map[string]bool{"OK": ok})
+			continue
+		}
+		switch scanner.Text() {
+		case "tun-start":
+			stage = "tun-open"
+			if tun != nil {
+				err = binat.ErrUnconfirmed
+				break
+			}
+			tun, err = os.OpenFile("/dev/net/tun", os.O_RDWR, 0)
+			if err != nil {
+				break
+			}
+			stage = "tun-ioctl"
+			var request [40]byte
+			copy(request[:16], "nb0")
+			binary.LittleEndian.PutUint16(request[16:18], 0x1001)
+			_, _, errno := syscall.Syscall(syscall.SYS_IOCTL, tun.Fd(), 0x400454ca, uintptr(unsafe.Pointer(&request[0])))
+			if errno != 0 {
+				err = errno
+				tun.Close()
+				tun = nil
+				break
+			}
+			stage = "tun-flags"
+			err = binat.RequireEphemeralTUN("nb0", true)
+			if err == nil {
+				g.BindFailStop(func() { os.Exit(1) })
+			}
+			if err != nil {
+				break
+			}
+			stage = "transport-bind"
+			transport, err = net.ListenPacket("udp4", "127.0.0.1:52183")
+			if err != nil {
+				break
+			}
+			// Synthetic decrypted transport for the isolated FD-lifetime test.
+			// Not WireGuard, not controller enrollment, never a production path.
+			go func() {
+				buffer := make([]byte, 4096)
+				for {
+					n, _, readErr := transport.ReadFrom(buffer)
+					if readErr != nil {
+						return
+					}
+					if n > 20 && buffer[0]>>4 == 4 {
+						tun.Write(buffer[:n])
+					}
+				}
+			}()
+		case "absent-opt-in":
+			previous := os.Getenv("NB_EXPERIMENTAL_BINAT_CONFIG")
+			os.Unsetenv("NB_EXPERIMENTAL_BINAT_CONFIG")
+			candidate, checkErr := binat.LoadLabFromEnv()
+			err = checkErr
+			if candidate != nil {
+				candidate.Release()
+			}
+			os.Setenv("NB_EXPERIMENTAL_BINAT_CONFIG", previous)
+		case "foreign-preflight":
+			err = binat.RefuseStalePassthroughs(scopes)
+		case "close":
+			if g == nil {
+				err = binat.ErrUnconfirmed
+			} else {
+				err = g.Close()
+			}
+		case "prepare":
+			if g == nil {
+				err = binat.ErrUnconfirmed
+			} else {
+				pending, err = g.Prepare()
+			}
+		case "open":
+			if g == nil {
+				err = binat.ErrUnconfirmed
+			} else {
+				var epoch uint64
+				epoch = pending
+				if epoch == 0 {
+					epoch, err = g.Prepare()
+				} else {
+					err = nil
+				}
+				if err == nil {
+					err = g.Open(epoch)
+					pending = 0
+				}
+			}
+		case "restart":
+			if g != nil {
+				err = g.Close()
+				if err != nil {
+					break
+				}
+				g.Release()
+				g = nil
+			}
+			g, err = binat.LoadLabFromEnv()
+			pending = 0
+		default:
+			err = binat.ErrUnconfirmed
+		}
+		response := map[string]any{"OK": err == nil}
+		if err != nil {
+			response["ErrorClass"] = stage
+		}
+		out.Encode(response)
+	}
+}
diff --git a/client/firewall/binat/gate_linux.go b/client/firewall/binat/gate_linux.go
new file mode 100644
--- /dev/null
+++ b/client/firewall/binat/gate_linux.go
@@ -0,0 +1,583 @@
+//go:build linux
+
+// Package binat provides only a synchronous availability gate. Native NetBird
+// ACLs remain the sole source of authorization; this gate contains no policies.
+package binat
+
+import (
+	"bytes"
+	"context"
+	"crypto/rand"
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"fmt"
+	nft "github.com/google/nftables"
+	nl "github.com/mdlayher/netlink"
+	"github.com/vishvananda/netlink"
+	"io"
+	"net"
+	"net/netip"
+	"os"
+	"os/exec"
+	"regexp"
+	"strings"
+	"sync"
+	"syscall"
+	"time"
+)
+
+const Table = "netbird_binat_native_gate_v1"
+const Root = "/run/netbird-binat-small-lab"
+
+var ErrUnconfirmed = errors.New("BINAT native gate closure unconfirmed")
+var names = regexp.MustCompile(`^[a-zA-Z0-9_.-]{1,15}$`)
+
+type Scope struct{ Virtual, Real, Overlay, LAN string }
+type Runner func(string) ([]byte, error)
+type Gate struct {
+	mutex      sync.Mutex
+	scopes     []Scope
+	run        Runner
+	lock       *os.File
+	marker     string
+	released   bool
+	epoch      uint64
+	seenSerial uint64
+	observed   string
+	hasSerial  bool
+	failStop   func()
+	poisoned   bool
+	references [2]string
+}
+
+var configured struct {
+	sync.RWMutex
+	active *Gate
+}
+
+func Active() bool { configured.RLock(); defer configured.RUnlock(); return configured.active != nil }
+func Scopes() []Scope {
+	configured.RLock()
+	defer configured.RUnlock()
+	if configured.active == nil {
+		return nil
+	}
+	return configured.active.Scopes()
+}
+func (g *Gate) Scopes() []Scope { return append([]Scope(nil), g.scopes...) }
+func CloseActive() error {
+	configured.RLock()
+	g := configured.active
+	configured.RUnlock()
+	if g != nil {
+		return g.Close()
+	}
+	if os.Getenv("NB_EXPERIMENTAL_BINAT_CONFIG") != "" {
+		return ErrUnconfirmed
+	}
+	return nil
+}
+func ValidateScopes(items []Scope) error {
+	if len(items) == 0 || len(items) > 16 {
+		return errors.New("BINAT invalid scope count")
+	}
+	for i, s := range items {
+		v, err := netip.ParsePrefix(s.Virtual)
+		if err != nil || !v.Addr().Is4() || v != v.Masked() || v.Bits() < 8 {
+			return errors.New("BINAT invalid virtual prefix")
+		}
+		r, err := netip.ParsePrefix(s.Real)
+		if err != nil || !r.Addr().Is4() || r != r.Masked() || r.Bits() != v.Bits() || r.Overlaps(v) {
+			return errors.New("BINAT invalid real prefix")
+		}
+		if !names.MatchString(s.Overlay) || !names.MatchString(s.LAN) || s.Overlay == s.LAN {
+			return errors.New("BINAT invalid interface")
+		}
+		for _, prior := range items[:i] {
+			n, _ := netip.ParsePrefix(prior.Virtual)
+			if n.Overlaps(v) {
+				return errors.New("BINAT ambiguous scope")
+			}
+		}
+	}
+	return nil
+}
+
+func privateFile(path string) ([]byte, error) {
+	f, err := os.OpenFile(path, os.O_RDONLY|syscall.O_NOFOLLOW, 0)
+	if err != nil {
+		return nil, errors.New("BINAT protected file missing")
+	}
+	defer f.Close()
+	st, err := f.Stat()
+	if err != nil || !st.Mode().IsRegular() || st.Mode().Perm() != 0600 || st.Sys().(*syscall.Stat_t).Uid != 0 || st.Size() > 1024*1024 {
+		return nil, errors.New("BINAT protected file unsafe")
+	}
+	b, err := io.ReadAll(io.LimitReader(f, 1024*1024+1))
+	if err != nil || int64(len(b)) != st.Size() {
+		return nil, errors.New("BINAT protected read incomplete")
+	}
+	return b, nil
+}
+
+func execute(script string) ([]byte, error) {
+	if len(script) > 65536 {
+		return nil, errors.New("BINAT gate transaction too large")
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
+	defer cancel()
+	cmd := exec.CommandContext(ctx, "/usr/sbin/nft", "-s", "-j", "-f", "-")
+	cmd.Stdin = strings.NewReader(script)
+	out := &boundedOutput{}
+	cmd.Stdout = out
+	if cmd.Run() != nil {
+		return nil, errors.New("BINAT gate kernel operation failed")
+	}
+	return out.Bytes(), nil
+}
+
+type boundedOutput struct{ bytes.Buffer }
+
+func (b *boundedOutput) Write(v []byte) (int, error) {
+	if len(v) > 1024*1024-b.Len() {
+		return 0, errors.New("BINAT gate readback too large")
+	}
+	return b.Buffer.Write(v)
+}
+func New(items []Scope, run Runner) (*Gate, error) {
+	if err := ValidateScopes(items); err != nil {
+		return nil, err
+	}
+	if run == nil {
+		run = execute
+	}
+	data, _ := json.Marshal(items)
+	sum := sha256.Sum256(data)
+	return &Gate{scopes: append([]Scope(nil), items...), run: run, marker: "netbird-native-binat-" + hex.EncodeToString(sum[:])}, nil
+}
+func LoadLabFromEnv() (*Gate, error) { return loadLabFromEnv(refuseOrphans) }
+func loadLabFromEnv(inspect func() error) (*Gate, error) {
+	value := os.Getenv("NB_EXPERIMENTAL_BINAT_CONFIG")
+	if value == "" {
+		if err := inspect(); err != nil {
+			return nil, err
+		}
+		return nil, nil
+	}
+	if value != Root+"/config.json" || os.Getenv("OPENMAIN_ISOLATED_TEST") != "1" {
+		return nil, errors.New("BINAT requires isolated small native lab")
+	}
+	if strings.HasPrefix(os.Getenv("NB_NFTABLES_TABLE"), Table) {
+		return nil, errors.New("BINAT native table ownership collision")
+	}
+	st, err := os.Lstat(Root)
+	if err != nil || !st.IsDir() || st.Mode().Perm() != 0700 || st.Sys().(*syscall.Stat_t).Uid != 0 {
+		return nil, errors.New("BINAT unsafe lab directory")
+	}
+	data, err := privateFile(value)
+	if err != nil {
+		return nil, err
+	}
+	var scopes []Scope
+	dec := json.NewDecoder(bytes.NewReader(data))
+	dec.DisallowUnknownFields()
+	if dec.Decode(&scopes) != nil || dec.Decode(&struct{}{}) != io.EOF {
+		return nil, errors.New("BINAT invalid scopes")
+	}
+	g, err := New(scopes, nil)
+	if err != nil {
+		return nil, err
+	}
+	f, err := os.OpenFile(Root+"/owner.lock", os.O_CREATE|os.O_RDWR|syscall.O_NOFOLLOW, 0600)
+	if err != nil {
+		return nil, ErrUnconfirmed
+	}
+	st, err = f.Stat()
+	if err != nil || !st.Mode().IsRegular() || st.Mode().Perm() != 0600 || st.Sys().(*syscall.Stat_t).Uid != 0 {
+		f.Close()
+		return nil, ErrUnconfirmed
+	}
+	if syscall.Flock(int(f.Fd()), syscall.LOCK_EX|syscall.LOCK_NB) != nil {
+		f.Close()
+		return nil, ErrUnconfirmed
+	}
+	g.lock = f
+	if err = g.Bootstrap(); err != nil {
+		f.Close()
+		return nil, err
+	}
+	configured.Lock()
+	configured.active = g
+	configured.Unlock()
+	return g, nil
+}
+func (g *Gate) layout() string {
+	text := fmt.Sprintf("create table ip %s { comment %q; }\nadd chain ip %s ready\nadd chain ip %s guard { type filter hook postrouting priority -200; policy accept; }\n", Table, g.marker, Table, Table)
+	for _, s := range g.scopes {
+		text += fmt.Sprintf("add rule ip %s guard ip daddr %s ct state invalid,untracked drop\nadd rule ip %s guard ct original ip daddr %s ct state invalid,untracked drop\nadd rule ip %s guard ct original ip daddr %s jump ready\nadd rule ip %s guard ct original ip daddr %s drop\n", Table, s.Virtual, Table, s.Virtual, Table, s.Virtual, Table, s.Virtual)
+	}
+	return text
+}
+
+// Adoption is only for this exact, scope-bound owned layout. Compare the kernel
+// table with closed/open reference layouts, excluding handles/counters only.
+func canonical(data []byte, table string) (string, error) {
+	var v struct {
+		NFTables []map[string]json.RawMessage `json:"nftables"`
+	}
+	if json.Unmarshal(data, &v) != nil {
+		return "", ErrUnconfirmed
+	}
+	tables, chains := 0, 0
+	var rows []map[string]any
+	for _, entry := range v.NFTables {
+		for kind, raw := range entry {
+			if kind != "metainfo" && kind != "table" && kind != "chain" && kind != "rule" {
+				return "", ErrUnconfirmed
+			}
+			if kind == "metainfo" {
+				continue
+			}
+			var row map[string]any
+			if json.Unmarshal(raw, &row) != nil {
+				return "", ErrUnconfirmed
+			}
+			if row["family"] != "ip" {
+				return "", ErrUnconfirmed
+			}
+			if kind == "table" {
+				tables++
+				if row["name"] != table {
+					return "", ErrUnconfirmed
+				}
+			}
+			if kind == "chain" {
+				chains++
+				if row["name"] != "ready" && row["name"] != "guard" {
+					return "", ErrUnconfirmed
+				}
+			}
+			delete(row, "handle")
+			if row["table"] == table {
+				row["table"] = Table
+			}
+			if kind == "table" && row["name"] == table {
+				row["name"] = Table
+			}
+			if exprs, ok := row["expr"].([]any); ok {
+				for _, x := range exprs {
+					if e, ok := x.(map[string]any); ok {
+						if _, ok := e["counter"]; ok {
+							e["counter"] = nil
+						}
+					}
+				}
+			}
+			rows = append(rows, map[string]any{kind: row})
+		}
+	}
+	if tables != 1 || chains != 2 {
+		return "", ErrUnconfirmed
+	}
+	encoded, _ := json.Marshal(rows)
+	return string(encoded), nil
+}
+func (g *Gate) permits() string {
+	return fmt.Sprintf("add rule ip %s ready counter accept comment %q\n", Table, "native-policy-ready")
+}
+func (g *Gate) known() error { return g.knownState(nil) }
+func (g *Gate) knownState(required *bool) error {
+	live, err := g.run("list table ip " + Table + "\n")
+	if err != nil {
+		return ErrUnconfirmed
+	}
+	actual, err := canonical(live, Table)
+	if err != nil {
+		return err
+	}
+	if g.references[0] != "" && g.references[1] != "" {
+		for i, expected := range g.references {
+			if actual == expected && (required == nil || (i == 1) == *required) {
+				return nil
+			}
+		}
+		return fmt.Errorf("%w: unknown gate layout; unchanged", ErrUnconfirmed)
+	}
+	// nft candidate has no packet hooks. Hook metadata is reinstated for comparison.
+	var nonce [8]byte
+	if _, err := rand.Read(nonce[:]); err != nil {
+		return ErrUnconfirmed
+	}
+	candidate := Table + "_check_" + hex.EncodeToString(nonce[:])
+	script := strings.ReplaceAll(g.layout(), Table, candidate)
+	script = strings.ReplaceAll(script, " { type filter hook postrouting priority -200; policy accept; }", "")
+	if _, err = g.run(script); err != nil {
+		return ErrUnconfirmed
+	}
+	defer g.run("delete table ip " + candidate + "\n")
+	for _, open := range []bool{false, true} {
+		if open {
+			if _, err = g.run(strings.ReplaceAll(g.permits(), Table, candidate)); err != nil {
+				return ErrUnconfirmed
+			}
+		}
+		data, err := g.run("list table ip " + candidate + "\n")
+		if err != nil {
+			return ErrUnconfirmed
+		}
+		var envelope map[string]any
+		if json.Unmarshal(data, &envelope) != nil {
+			return ErrUnconfirmed
+		}
+		rows, ok := envelope["nftables"].([]any)
+		if !ok {
+			return ErrUnconfirmed
+		}
+		for _, raw := range rows {
+			item, ok := raw.(map[string]any)
+			if !ok {
+				return ErrUnconfirmed
+			}
+			if chain, ok := item["chain"].(map[string]any); ok && chain["name"] == "guard" {
+				chain["type"] = "filter"
+				chain["hook"] = "postrouting"
+				chain["prio"] = float64(-200)
+				chain["policy"] = "accept"
+			}
+		}
+		expected, _ := json.Marshal(envelope)
+		normal, err := canonical(expected, candidate)
+		if err != nil {
+			return err
+		}
+		index := 0
+		if open {
+			index = 1
+		}
+		g.references[index] = normal
+	}
+	for i, expected := range g.references {
+		if expected == actual && (required == nil || (i == 1) == *required) {
+			return nil
+		}
+	}
+	return fmt.Errorf("%w: unknown gate layout; unchanged", ErrUnconfirmed)
+}
+func (g *Gate) Bootstrap() error {
+	tables, err := g.run("list tables\n")
+	if err != nil {
+		return ErrUnconfirmed
+	}
+	var v struct {
+		NFTables []struct {
+			Table struct{ Name, Family string } `json:"table"`
+		} `json:"nftables"`
+	}
+	if json.Unmarshal(tables, &v) != nil {
+		return ErrUnconfirmed
+	}
+	exists := false
+	for _, x := range v.NFTables {
+		if x.Table.Name == Table && x.Table.Family == "ip" {
+			exists = true
+		}
+	}
+	if !exists {
+		if _, err = g.run(g.layout()); err != nil {
+			return ErrUnconfirmed
+		}
+	}
+	return g.Close()
+}
+
+// If kernel closure cannot be confirmed, terminate the verified TUN owner.
+// This uses the existing NetBird service restart; no watcher/recovery daemon.
+func (g *Gate) BindFailStop(stop func()) { g.mutex.Lock(); defer g.mutex.Unlock(); g.failStop = stop }
+func (g *Gate) closeLocked() (result error) {
+	defer func() {
+		if result != nil {
+			g.poisoned = true
+			if g.failStop != nil {
+				g.failStop()
+			}
+		}
+	}()
+	if g.released {
+		return ErrUnconfirmed
+	}
+	if err := g.known(); err != nil {
+		return err
+	}
+	if _, err := g.run("flush chain ip " + Table + " ready\n"); err != nil {
+		return ErrUnconfirmed
+	}
+	data, err := g.run("list chain ip " + Table + " ready\n")
+	if err != nil {
+		return ErrUnconfirmed
+	}
+	var v struct {
+		NFTables []map[string]any `json:"nftables"`
+	}
+	if json.Unmarshal(data, &v) != nil {
+		return ErrUnconfirmed
+	}
+	for _, e := range v.NFTables {
+		if _, ok := e["rule"]; ok {
+			return ErrUnconfirmed
+		}
+	}
+	return nil
+}
+func (g *Gate) Close() error {
+	g.mutex.Lock()
+	defer g.mutex.Unlock()
+	g.epoch++
+	return g.closeLocked()
+}
+
+// Called only after native map/ACL/backend success, under Engine.syncMsgMux.
+// This confirms local readiness, never a controller acknowledgement.
+func (g *Gate) Prepare() (uint64, error) {
+	g.mutex.Lock()
+	defer g.mutex.Unlock()
+	g.epoch++
+	if err := g.closeLocked(); err != nil {
+		return 0, err
+	}
+	return g.epoch, nil
+}
+func (g *Gate) Open(epoch uint64) error {
+	g.mutex.Lock()
+	defer g.mutex.Unlock()
+	if g.poisoned || epoch != g.epoch {
+		return ErrUnconfirmed
+	}
+	if err := g.closeLocked(); err != nil {
+		return err
+	}
+	_, err := g.run(g.permits())
+	if err == nil {
+		wantOpen := true
+		err = g.knownState(&wantOpen)
+	}
+	if err != nil {
+		if g.closeLocked() != nil {
+			return ErrUnconfirmed
+		}
+		return errors.New("BINAT opening failed; closure confirmed")
+	}
+	return nil
+}
+func (g *Gate) Release() {
+	g.mutex.Lock()
+	defer g.mutex.Unlock()
+	g.released = true
+	g.failStop = nil
+	configured.Lock()
+	if configured.active == g {
+		configured.active = nil
+	}
+	configured.Unlock()
+	if g.lock != nil {
+		g.lock.Close()
+		g.lock = nil
+	}
+}
+
+// In-process ordering fence only. Restart never reuses an authorization ACK;
+// the next full authenticated NetworkMap must pass validation and native apply.
+func (g *Gate) Observe(serial uint64, digest string) error {
+	g.mutex.Lock()
+	defer g.mutex.Unlock()
+	if g.released || len(digest) != 64 {
+		return ErrUnconfirmed
+	}
+	if _, err := hex.DecodeString(digest); err != nil {
+		return ErrUnconfirmed
+	}
+	if g.hasSerial && (serial < g.seenSerial || serial == g.seenSerial && digest != g.observed) {
+		return ErrUnconfirmed
+	}
+	g.hasSerial = true
+	g.seenSerial = serial
+	g.observed = digest
+	return nil
+}
+
+// A kernel WireGuard interface can outlive the policy owner. Use NetBird's
+// existing userspace bind on a fresh nonpersistent TUN, never auto-migrate.
+func RequireFreshUserspaceOverlay(scopes []Scope) error {
+	if os.Getenv("NB_WG_KERNEL_DISABLED") != "true" {
+		return errors.New("BINAT requires explicit NetBird userspace WireGuard")
+	}
+	interfaces, err := net.Interfaces()
+	if err != nil {
+		return ErrUnconfirmed
+	}
+	for _, scope := range scopes {
+		for _, nic := range interfaces {
+			if nic.Name == scope.Overlay {
+				return errors.New("BINAT refuses existing overlay interface")
+			}
+		}
+	}
+	// The owned gate is already closed. Refuse foreign passthroughs before
+	// creating an interface whose name could reactivate a stale ACCEPT.
+	return RefuseStalePassthroughs(scopes)
+}
+func RequireEphemeralTUN(name string, userspace bool) error {
+	if !userspace || !names.MatchString(name) {
+		return errors.New("BINAT requires process-owned TUN")
+	}
+	link, err := netlink.LinkByName(name)
+	if err != nil {
+		return ErrUnconfirmed
+	}
+	return validateTUNLink(link)
+}
+func validateTUNLink(link netlink.Link) error {
+	tun, ok := link.(*netlink.Tuntap)
+	if !ok || tun.Mode != netlink.TUNTAP_MODE_TUN || !tun.NonPersist {
+		return errors.New("BINAT persistent/non-TUN interface refused")
+	}
+	return nil
+}
+
+// Always read the CURRENT namespace before a no-opt-in Engine can create its
+// tunnel. Refuse rather than modifying any unconfigured/foreign firewall state.
+func refuseOrphans() error {
+	conn, err := nft.New(nft.WithSockOptions(func(c *nl.Conn) error { return c.SetReadDeadline(time.Now().Add(10 * time.Second)) }))
+	if err != nil {
+		return ErrUnconfirmed
+	}
+	tables, err := conn.ListTables()
+	if err != nil {
+		return ErrUnconfirmed
+	}
+	chains, err := conn.ListChains()
+	if err != nil {
+		return ErrUnconfirmed
+	}
+	return orphanedBoundary(tables, chains)
+}
+func orphanedBoundary(tables []*nft.Table, chains []*nft.Chain) error {
+	for _, table := range tables {
+		if table == nil {
+			return ErrUnconfirmed
+		}
+		if table.Family == nft.TableFamilyIPv4 && (table.Name == Table || table.Name == "netbird_binat_experiment_v3") {
+			return errors.New("BINAT orphaned boundary: explicit configuration/verified manual cleanup required")
+		}
+	}
+	for _, chain := range chains {
+		if chain == nil || chain.Table == nil {
+			return ErrUnconfirmed
+		}
+		if chain.Table.Family == nft.TableFamilyIPv4 && chain.Name == "netbird-binat-native" {
+			return errors.New("BINAT orphaned native boundary: configuration required")
+		}
+	}
+	return nil
+}
