+)
+
+func TestBINATNativeAuthoritativeMapIncludesDenyAndPorts(t *testing.T) {
+	scopes := []binat.Scope{{Virtual: "10.80.1.0/24", Real: "192.168.80.0/24", Overlay: "nb0", LAN: "lan0"}}
+	rule := &p.RouteFirewallRule{SourceRanges: []string{"100.64.0.10/32", "100.64.0.11/32"}, Destination: "10.80.1.0/24", Protocol: p.RuleProtocol_TCP, Action: p.RuleAction_DROP, PortInfo: &p.PortInfo{PortSelection: &p.PortInfo_Range_{Range: &p.PortInfo_Range{Start: 443, End: 445}}}}
+	m := &p.NetworkMap{Serial: 8, FirewallRulesIsEmpty: true, RoutesFirewallRules: []*p.RouteFirewallRule{rule}}
+	rows, err := BINATRules(m, scopes)
+	if err != nil || len(rows) != 2 || rows[0].Action != "drop" || rows[0].Ports[0] != [2]uint16{443, 445} {
+		t.Fatal("native complete map not preserved")
+	}
+	m.RoutesFirewallRules = nil
+	m.RoutesFirewallRulesIsEmpty = false
+	if _, err = BINATRules(m, scopes); err == nil {
+		t.Fatal("partial map accepted")
+	}
+	m.RoutesFirewallRulesIsEmpty = true
+	if rows, err = BINATRules(m, scopes); err != nil || len(rows) != 0 {
+		t.Fatal("explicit empty policy rejected")
+	}
+	m.RoutesFirewallRules = []*p.RouteFirewallRule{rule}
+	rule.IsDynamic = true
+	if _, err = BINATRules(m, scopes); err == nil {
+		t.Fatal("dynamic subset published")
+	}
+}
+
+func TestBINATNativeObservedDigestBindsPartialAndContradictoryPolicy(t *testing.T) {
+	m := &p.NetworkMap{Serial: 10, FirewallRulesIsEmpty: true, RoutesFirewallRulesIsEmpty: true}
+	first, err := BINATPolicyDigest(m)
+	if err != nil || len(first) != 64 {
+		t.Fatal("policy observation absent")
+	}
+	m.Serial = 11
+	same, err := BINATPolicyDigest(m)
+	if err != nil || same != first {
+		t.Fatal("generation mixed into policy digest")
+	}
+	m.RoutesFirewallRulesIsEmpty = false
+	changed, err := BINATPolicyDigest(m)
+	if err != nil || changed == first {
+		t.Fatal("partial policy unbound")
+	}
+}
