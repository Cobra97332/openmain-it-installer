+	observed := make(map[string]map[string]bool)
+	for _, tracked := range m.family4.filters {
+		if tracked.nftRule == nil || tracked.nftRule.Chain == nil {
+			return fmt.Errorf("BINAT native handle missing")
+		}
+		name := tracked.nftRule.Chain.Name
+		if live[name] == nil {
+			return fmt.Errorf("BINAT native ACL chain missing")
+		}
+		if observed[name] == nil {
+			rows, readErr := m.rConn.GetRules(m.family4.workTable, live[name])
+			if readErr != nil {
+				return fmt.Errorf("BINAT native ACL readback failed")
+			}
+			observed[name] = make(map[string]bool)
+			for _, row := range rows {
+				observed[name][string(row.UserData)] = true
+			}
+		}
+		if !observed[name][string(tracked.nftRule.UserData)] {
